<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        ZeroStrap Obsidian component library. Styles wrap wpfui primitives so the
        whole app shares one visual grammar. Everything is theme-aware.
    -->

    <!-- ============================== PRIMARY BUTTON ============================== -->

    <Style x:Key="ZeroButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="ZeroButtonPrimary" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource ZeroButton}">
        <Setter Property="Appearance" Value="Primary" />
    </Style>

    <Style x:Key="ZeroButtonSecondary" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource ZeroButton}">
        <Setter Property="Appearance" Value="Secondary" />
    </Style>

    <Style x:Key="ZeroButtonGhost" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource ZeroButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!--  Icon-only square button for toolbars. 32x32 target so it reads with the body copy.  -->
    <Style x:Key="ZeroIconButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource ZeroButton}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- ============================== STATUS INDICATOR ============================== -->

    <!--  12x12 dot that reads at the end of a line of body text. Fill is picked per instance.  -->
    <Style x:Key="ZeroStatusDotStyle" TargetType="{x:Type Ellipse}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <SolidColorBrush x:Key="ZeroStatusHealthyBrush" Color="#43B581" />
    <SolidColorBrush x:Key="ZeroStatusWarningBrush" Color="#D4A054" />
    <SolidColorBrush x:Key="ZeroStatusErrorBrush" Color="#D15B5B" />
    <SolidColorBrush x:Key="ZeroStatusIdleBrush" Color="#686868" />

    <!-- ============================== SECTION HEADER ============================== -->

    <Style x:Key="ZeroSectionHeaderStackStyle" TargetType="{x:Type StackPanel}">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- ============================== TOGGLE ============================== -->

    <Style x:Key="ZeroToggle" TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!--  Row combining a label and a toggle; use inside Configure/Appearance panels.  -->
    <Style x:Key="ZeroSettingRowStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!-- ============================== DROPDOWN ============================== -->

    <Style x:Key="ZeroDropdown" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- ============================== TEXT FIELD ============================== -->

    <Style x:Key="ZeroTextField" TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- ============================== NAV ITEM (sidebar) ============================== -->

    <!--
        Sidebar nav item: 40px row, icon on the left, label, selection stripe on the left.
        Toggleable so a RadioButton-style group behaves correctly inside the shell.
    -->
    <Style x:Key="ZeroNavItem" TargetType="{x:Type RadioButton}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid>
                        <Border x:Name="Bg"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}" />
                        <Border x:Name="Stripe"
                                Width="3"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Margin="0,8"
                                Background="{DynamicResource TextFillColorPrimaryBrush}"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            <Setter TargetName="Stripe" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== LARGE ACTION TILE ============================== -->

    <!--
        4-up tile used on Overview to launch into Configure / Appearance / System / Profiles.
        Card body + hover outline, hit target the whole tile.
    -->
    <Style x:Key="ZeroActionTileStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ZeroCardStyle}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="MinHeight" Value="120" />
    </Style>

    <!-- ============================== TOAST ============================== -->

    <!--  Alias; the wpfui Snackbar is the toast primitive. Kept here so pages reference ZeroToast.  -->
    <Style x:Key="ZeroToast" TargetType="{x:Type ui:Snackbar}" BasedOn="{StaticResource {x:Type ui:Snackbar}}" />

    <!-- ============================== DIALOG SHELL ============================== -->

    <!--  Content-area style for a dialog body. Footer uses ZeroDialogFooterStyle from ZeroBrand.  -->
    <Style x:Key="ZeroDialogBodyStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="24,20" />
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
    </Style>

    <!-- ============================== COMMAND PALETTE ============================== -->

    <!--  Top search affordance. Phase 1: static chrome; Phase 6 hooks the behaviour.  -->
    <Style x:Key="ZeroCommandPaletteStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="420" />
    </Style>

    <!-- ============================== LIST ROW ============================== -->

    <!--  Horizontal row for activity feeds, log tables, launch history.  -->
    <Style x:Key="ZeroListRowStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!-- ============================== META LABEL ============================== -->

    <!--  Small secondary line of metadata next to a title.  -->
    <Style x:Key="ZeroMetaTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================== MONO LABEL ============================== -->

    <Style x:Key="ZeroMonoTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource ZeroMonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

</ResourceDictionary>
