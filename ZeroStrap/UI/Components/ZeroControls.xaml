<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:ZeroStrap.UI.Converters"
    xmlns:utility="clr-namespace:ZeroStrap.UI.Utility"
    xmlns:theming="clr-namespace:ZeroStrap.UI.Theming">

    <!--
        ZeroStrap Obsidian component library. Styles wrap wpfui primitives so the
        whole app shares one visual grammar. Everything is theme-aware.

        Motion rule: hover/press feedback animates an overlay's Opacity (or a transform),
        never a theme brush, so DynamicResource brushes stay frozen and theme switches stay instant.
    -->

    <BackEase x:Key="ZeroEaseOutBack" EasingMode="EaseOut" Amplitude="0.35" />

    <!-- ============================== BUTTONS ============================== -->

    <Style x:Key="ZeroButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize13}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="ZeroButtonPrimary" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource ZeroButton}">
        <Setter Property="Appearance" Value="Primary" />
        <Style.Triggers>
            <!--
                Components.ButtonStyle = Subtle: a ~14% accent tint with accent-coloured text instead of the solid
                accent fill. ThemeState.SubtleButtons is set by ThemeManager; these triggers follow WPF-UI's own
                Appearance trigger, so they win for the properties both set.
            -->
            <DataTrigger Binding="{Binding Source={x:Static theming:ThemeState.Instance}, Path=SubtleButtons}" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.14" Color="{DynamicResource SystemAccentColorSecondary}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="MouseOverBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.22" Color="{DynamicResource SystemAccentColorSecondary}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="PressedBackground">
                    <Setter.Value>
                        <SolidColorBrush Opacity="0.30" Color="{DynamicResource SystemAccentColorSecondary}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="PressedForeground">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                    </Setter.Value>
                </Setter>
                <Setter Property="IconForeground">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ZeroButtonSecondary" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource ZeroButton}">
        <Setter Property="Appearance" Value="Secondary" />
    </Style>

    <Style x:Key="ZeroButtonGhost" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource ZeroButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="{DynamicResource ZeroFontWeightBody}" />
    </Style>

    <Style x:Key="ZeroIconButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource ZeroButton}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--
        Flat interactive surface (header icons, window caption buttons, sidebar utility rows,
        list rows). Transparent at rest, a soft fill fades in on hover, a little darker on press.
    -->
    <Style x:Key="ZeroFlatButton" TargetType="{x:Type Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize13}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <Border x:Name="Fill" CornerRadius="{DynamicResource ZeroRadius8}" Background="{DynamicResource ControlFillColorTertiaryBrush}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.14" EasingFunction="{StaticResource ZeroEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource ZeroEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  Square icon button for the top bar (34x34).  -->
    <Style x:Key="ZeroHeaderIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ZeroFlatButton}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!--  Window caption buttons (minimise / maximise / close), flush with the top bar.  -->
    <Style x:Key="ZeroCaptionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ZeroFlatButton}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <!--
        Interactive card. Hover: the surface lifts 2px, an elevated fill and a brighter outline fade in.
        Press: settles back down. Content is free-form.
    -->
    <Style x:Key="ZeroTileButton" TargetType="{x:Type Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="Surface" CornerRadius="{DynamicResource ZeroRadiusSurface}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="{DynamicResource ZeroSurfaceBorderThickness}" />
                        <Border x:Name="Lift" CornerRadius="{DynamicResource ZeroRadiusSurface}"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Opacity="0" />
                        <Border x:Name="Outline" CornerRadius="{DynamicResource ZeroRadiusSurface}" BorderThickness="1"
                                BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource ZeroEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Outline" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.18" EasingFunction="{StaticResource ZeroEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="-2" Duration="0:0:0.22" EasingFunction="{StaticResource ZeroEaseOutStrong}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26" EasingFunction="{StaticResource ZeroEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Outline" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26" EasingFunction="{StaticResource ZeroEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.28" EasingFunction="{StaticResource ZeroEaseOutStrong}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outline" Property="Opacity" Value="0.26" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Selected state for a tile used as a choice (theme cards): solid outline.  -->
    <Style x:Key="ZeroChoiceTile" TargetType="{x:Type RadioButton}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid>
                        <Border CornerRadius="{DynamicResource ZeroRadiusSurface}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="{DynamicResource ZeroSurfaceBorderThickness}" />
                        <Border x:Name="Lift" CornerRadius="{DynamicResource ZeroRadiusSurface}"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Opacity="0" />
                        <Border x:Name="Outline" CornerRadius="{DynamicResource ZeroRadiusSurface}" BorderThickness="1.5"
                                BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                        <Border x:Name="Check" Width="20" Height="20" CornerRadius="10" Margin="0,10,10,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                            </Border.RenderTransform>
                            <ui:SymbolIcon Symbol="Checkmark12" FontSize="12" Foreground="{DynamicResource ApplicationBackgroundBrush}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource ZeroEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26" EasingFunction="{StaticResource ZeroEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Outline" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.2" EasingFunction="{StaticResource ZeroEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource ZeroEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.32" EasingFunction="{StaticResource ZeroEaseOutBack}" />
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.32" EasingFunction="{StaticResource ZeroEaseOutBack}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Outline" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.6" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.6" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  Small round theme switch used in the Theme Preview card.  -->
    <Style x:Key="ThemeDotStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid Background="Transparent">
                        <Ellipse Stroke="{DynamicResource TextFillColorTertiaryBrush}" StrokeThickness="1.2" />
                        <Ellipse x:Name="Dot" Margin="3" Fill="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="0.4" ScaleY="0.4" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource ZeroEaseOutBack}" />
                                        <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource ZeroEaseOutBack}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.4" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.4" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== STATUS INDICATOR ============================== -->

    <Style x:Key="ZeroStatusDotStyle" TargetType="{x:Type Ellipse}">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <SolidColorBrush x:Key="ZeroStatusHealthyBrush" Color="#3FBF7F" />
    <SolidColorBrush x:Key="ZeroStatusWarningBrush" Color="#D4A054" />
    <SolidColorBrush x:Key="ZeroStatusErrorBrush" Color="#D15B5B" />
    <SolidColorBrush x:Key="ZeroStatusInfoBrush" Color="#5E9BD6" />
    <SolidColorBrush x:Key="ZeroStatusIdleBrush" Color="#686868" />

    <!--  "READY" style pill: tinted semantic background, semantic text.  -->
    <Style x:Key="ZeroStatusPillStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{DynamicResource ZeroRadius5}" />
        <Setter Property="Padding" Value="8,2,8,3" />
        <Setter Property="Background" Value="#1A3FBF7F" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================== SECTION HEADER ============================== -->

    <Style x:Key="ZeroSectionHeaderStackStyle" TargetType="{x:Type StackPanel}">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!--  Card heading (System Status, Quick Information...).  -->
    <Style x:Key="ZeroCardTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize15}" />
        <Setter Property="FontWeight" Value="{DynamicResource ZeroFontWeightHeading}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- ============================== TOGGLE ============================== -->

    <Style x:Key="ZeroToggle" TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="ZeroSettingRowStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="{DynamicResource ZeroSettingRowPadding}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!-- ============================== DROPDOWN / TEXT FIELD ============================== -->

    <Style x:Key="ZeroDropdown" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize13}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ZeroTextField" TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize13}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- ============================== NAV ITEM (sidebar) ============================== -->

    <!--
        Sidebar nav item: 44px row. Hover fades a soft fill in; selection crossfades to a stronger
        fill and grows a 3px stripe from the centre. Content is icon + label (+ optional chip).
    -->
    <Style x:Key="ZeroNavItem" TargetType="{x:Type RadioButton}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize14}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="14,0,10,0" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" CornerRadius="{DynamicResource ZeroRadius10}" Background="{DynamicResource ControlFillColorSecondaryBrush}" Opacity="0" />
                        <Border x:Name="Selected" CornerRadius="{DynamicResource ZeroRadius10}" Background="{DynamicResource ControlFillColorTertiaryBrush}" Opacity="0" />
                        <Border x:Name="Stripe" Width="3" Height="18" HorizontalAlignment="Left" CornerRadius="2"
                                Background="{DynamicResource TextFillColorPrimaryBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="0" />
                            </Border.RenderTransform>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" EasingFunction="{StaticResource ZeroEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24" EasingFunction="{StaticResource ZeroEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource ZeroEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Stripe" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.32" EasingFunction="{StaticResource ZeroEaseOutStrong}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource ZeroEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Stripe" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource ZeroEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== SMALL PARTS ============================== -->

    <!--  36x36 rounded tile that hosts a SymbolIcon in rows and action cards.  -->
    <Style x:Key="ZeroIconTileStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="{DynamicResource ZeroRadius10}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="ZeroIconTileGlyphStyle" TargetType="{x:Type ui:SymbolIcon}" BasedOn="{StaticResource {x:Type ui:SymbolIcon}}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Trailing ">" affordance on navigable rows and tiles.  -->
    <Style x:Key="ZeroChevronStyle" TargetType="{x:Type ui:SymbolIcon}" BasedOn="{StaticResource {x:Type ui:SymbolIcon}}">
        <Setter Property="Symbol" Value="ChevronRight16" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Keyboard shortcut chip: "Ctrl + K".  -->
    <Style x:Key="ZeroKbdStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{DynamicResource ZeroRadius5}" />
        <Setter Property="Padding" Value="6,1,6,2" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ZeroKbdTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize10_5}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!--  Thin divider between rows inside a card.  -->
    <Style x:Key="ZeroDividerStyle" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  Large action tile kept for back-compat (non-interactive card with hand cursor).  -->
    <Style x:Key="ZeroActionTileStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ZeroCardStyle}">
        <Setter Property="Padding" Value="18" />
        <Setter Property="MinHeight" Value="120" />
    </Style>

    <!-- ============================== TOAST ============================== -->

    <Style x:Key="ZeroToast" TargetType="{x:Type ui:Snackbar}" BasedOn="{StaticResource {x:Type ui:Snackbar}}" />

    <!-- ============================== DIALOG SHELL ============================== -->

    <Style x:Key="ZeroDialogBodyStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="24,20" />
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
    </Style>

    <!-- ============================== COMMAND PALETTE ============================== -->

    <!--  Search field in the top bar. Focus brightens the outline.  -->
    <Style x:Key="ZeroCommandPaletteStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{DynamicResource ZeroRadius10}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0,8,0" />
        <Setter Property="Height" Value="38" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Plain text box with no chrome, used inside the palette field.  -->
    <Style x:Key="ZeroBareTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize13}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Result row in the palette popup.  -->
    <Style x:Key="ZeroPaletteItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent">
                        <Border x:Name="Fill" CornerRadius="{DynamicResource ZeroRadius8}" Background="{DynamicResource ControlFillColorTertiaryBrush}" Opacity="0" />
                        <ContentPresenter Margin="10,8" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== LIST ROW ============================== -->

    <Style x:Key="ZeroListRowStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="{DynamicResource ZeroListRowPadding}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!-- ============================== META / MONO LABELS ============================== -->

    <Style x:Key="ZeroMetaTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize12}" />
        <Setter Property="FontWeight" Value="{DynamicResource ZeroFontWeightBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ZeroMonoTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource ZeroMonoFont}" />
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize12}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================== SETTING CARD ROW / SMALL GHOST BUTTON ============================== -->

    <!--  A setting row drawn as its own card: 18,16 padding, 8px gap to the next row.  -->
    <Style x:Key="ZeroSettingCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ZeroSettingRowStyle}">
        <Setter Property="Padding" Value="{DynamicResource ZeroSettingCardPadding}" />
        <Setter Property="Margin" Value="{DynamicResource ZeroSettingCardMargin}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ZeroSurfaceBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ZeroRadiusSurface}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="ZeroButtonGhostSmall" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource ZeroButtonGhost}">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize12}" />
    </Style>

    <!-- ============================== SEGMENTED LIST ============================== -->

    <!--  One segment. Same hover fill, raised pill and radius as ZeroSegmentedTabItemStyle.  -->
    <Style x:Key="ZeroSegmentedListItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize13}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent" Margin="2,1">
                        <Border x:Name="Hover" CornerRadius="{DynamicResource ZeroRadius8}" Background="{DynamicResource ControlFillColorSecondaryBrush}" Opacity="0" />
                        <Border x:Name="Pill" CornerRadius="{DynamicResource ZeroRadius8}" Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Opacity="0" />
                        <ContentPresenter Margin="16,7,16,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource ZeroEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Horizontal single-choice strip in the same rounded track as ZeroSegmentedTabControlStyle. Wraps when narrow.  -->
    <Style x:Key="ZeroSegmentedList" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ZeroSegmentedListItemStyle}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border CornerRadius="{DynamicResource ZeroRadius10}" Padding="3,2"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== TOGGLE BUTTON (toolbar) ============================== -->

    <!--  Outlined toolbar toggle: matches ZeroButtonGhost at rest, fills and shows a check when on.  -->
    <Style x:Key="ZeroToolbarToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize13}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid>
                        <Border x:Name="Surface" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1"
                                Background="Transparent" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Border x:Name="Fill" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}" Opacity="0" />
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon x:Name="Check" Symbol="Checkmark16" FontSize="12" Margin="0,0,7,0" Visibility="Collapsed"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.7" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="1" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== DATA GRID ============================== -->

    <converters:UpperCaseConverter x:Key="ZeroUpperCaseConverter" />

    <!--  Header: small uppercase caption over a bottom divider.  -->
    <Style x:Key="ZeroDataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize11}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Typography.CapitalSpacing" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ZeroUpperCaseConverter}}"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Row: 36px, a horizontal divider only, hover fill and a subtle selected fill with a thin leading rule.  -->
    <Style x:Key="ZeroDataGridRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ValidationErrorTemplate" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridRow}">
                    <Border x:Name="Row" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Border x:Name="Hover" Background="{DynamicResource ControlFillColorSecondaryBrush}" Opacity="0" />
                            <Border x:Name="Selected" Background="{DynamicResource ControlFillColorTertiaryBrush}" Opacity="0" />
                            <Border x:Name="Rule" Width="2" HorizontalAlignment="Left" Background="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0" />
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            <Setter TargetName="Rule" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ZeroDataGridCell" TargetType="{x:Type DataGridCell}">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  Leave room for the edit box's own padding so the text does not jump.  -->
            <Trigger Property="IsEditing" Value="True">
                <Setter Property="Padding" Value="6,0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  The text box that appears while a cell is being edited.  -->
    <Style x:Key="ZeroDataGridEditTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1" Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The grid: transparent, horizontal dividers only, 36px rows, no focus rectangle.  -->
    <Style x:Key="ZeroDataGrid" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="MinRowHeight" Value="36" />
        <Setter Property="ColumnHeaderHeight" Value="34" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ZeroDataGridColumnHeaderStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource ZeroDataGridRowStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource ZeroDataGridCell}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Style.Resources>
            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource ZeroDataGridEditTextBox}" />
        </Style.Resources>
    </Style>

    <!--  Cell text inside a ZeroDataGrid: single line, ellipsis, vertically centred.  -->
    <Style x:Key="ZeroDataGridTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="ZeroDataGridMetaTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ZeroDataGridTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!--  Surface that holds a grid: panel look, content clipped to the rounded corners.  -->
    <Style x:Key="ZeroGridSurfaceStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ZeroPanelStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ZeroRadiusSurface}" />
        <Setter Property="utility:RoundedClip.Enabled" Value="True" />
    </Style>

    <!--  Label / value row in an info card.  -->
    <Style x:Key="ZeroInfoLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize12_5}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ZeroInfoValueStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource ZeroFontSize12_5}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

</ResourceDictionary>
