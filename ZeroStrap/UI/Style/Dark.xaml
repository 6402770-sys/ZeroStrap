<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ===================== ZeroStrap OBSIDIAN palette =====================
         Background #0E0E0E / content #101010 / surface #151515 / elevated #1F1F1F-#252525
         borders #222222-#303030 / text #F2F2F2 / secondary #A0A0A0 / muted #686868  -->
    <Color x:Key="ApplicationBackgroundColor">#FF0E0E0E</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}" />

    <!--  Solid layer bases  -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF101010" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF0B0B0B" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF252525" />

    <!--  Cards / layers (surfaces)  -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF151515" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF151515" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF151515" />

    <!--  Strokes / borders / dividers  -->
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF242424" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF242424" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FF222222" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF303030" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF3E3E3E" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#FF242424" />

    <!--  Control fills (ui:Card and inputs read these COLORS, not brushes)  -->
    <Color x:Key="ControlFillColorDefault">#FF191919</Color>
    <Color x:Key="ControlFillColorSecondary">#FF1F1F1F</Color>
    <Color x:Key="ControlFillColorTertiary">#FF252525</Color>
    <Color x:Key="ControlFillColorInputActive">#FF121212</Color>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource ControlFillColorSecondary}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource ControlFillColorTertiary}" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource ControlFillColorInputActive}" />

    <!--  Elevation border: default Card border brush  -->
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#FF2A2A2A" />

    <!--  Text hierarchy  -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF767676" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF5E5E5E" />
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="#FF686868" />

    <SolidColorBrush x:Key="NewTextEditorBackground" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="White" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#E0E0E0" />
</ResourceDictionary>