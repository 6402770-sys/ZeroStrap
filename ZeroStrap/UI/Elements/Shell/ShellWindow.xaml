<base:WpfUiWindow x:Class="ZeroStrap.UI.Elements.Shell.ShellWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:base="clr-namespace:ZeroStrap.UI.Elements.Base"
                  xmlns:resources="clr-namespace:ZeroStrap.Resources"
                  xmlns:vm="clr-namespace:ZeroStrap.UI.ViewModels.Shell"
                  xmlns:zs="clr-namespace:ZeroStrap"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance vm:ShellViewModel, IsDesignTimeCreatable=True}"
                  Title="ZeroStrap"
                  MinWidth="1100"
                  Width="1200"
                  MinHeight="640"
                  Height="760"
                  Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="None"
                  WindowStartupLocation="CenterScreen"
                  Closing="WpfUiWindow_Closing"
                  Closed="WpfUiWindow_Closed">

    <Grid Style="{StaticResource ZeroWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Snackbar x:Name="SettingsSavedSnackbar"
                     Title="{x:Static resources:Strings.Menu_SettingsSaved_Title}"
                     Message="{x:Static resources:Strings.Menu_SettingsSaved_Message}"
                     Appearance="Success" Icon="CheckmarkCircle32" Timeout="3000"
                     Margin="200,0,200,20" Grid.RowSpan="10" Panel.ZIndex="9" />

        <ui:Snackbar x:Name="FlagBindingSnackbar"
                     Title="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_SnackbarTitle}"
                     Icon="Keyboard24" Timeout="4000"
                     Margin="200,0,200,20" Grid.RowSpan="10" Panel.ZIndex="11" />

        <!-- ============================== TITLE BAR ============================== -->
        <ui:TitleBar Padding="8" Grid.Row="0" ForceShutdown="False" MinimizeToTray="False"
                     UseSnapLayout="True" Title="" Icon="{x:Null}">
            <ui:TitleBar.Header>
                <ContentPresenter Content="ZeroStrap" ContentTemplate="{StaticResource ZeroTitleBarLockup}" VerticalAlignment="Center" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ============================== BODY ============================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="12,14,12,0">
                        <TextBlock Text="WORKSPACE" Style="{StaticResource ZeroEyebrowStyle}" Margin="12,0,0,8" />
                        <RadioButton x:Name="NavOverview" Style="{StaticResource ZeroNavItem}" GroupName="ShellNav"
                                     IsChecked="True" Checked="Nav_Checked" Tag="Overview">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="Overview" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavPlay" Style="{StaticResource ZeroNavItem}" GroupName="ShellNav"
                                     Checked="Nav_Checked" Tag="Play">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="Play" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavConfigure" Style="{StaticResource ZeroNavItem}" GroupName="ShellNav"
                                     Checked="Nav_Checked" Tag="Configure">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="Configure" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource ZeroNavItem}" GroupName="ShellNav"
                                     Checked="Nav_Checked" Tag="Appearance">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PaintBrush24" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="Appearance" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSystem" Style="{StaticResource ZeroNavItem}" GroupName="ShellNav"
                                     Checked="Nav_Checked" Tag="System">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DeviceEq24" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="System" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Sidebar footer -->
                    <StackPanel Grid.Row="1" Margin="12,0,12,16">
                        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="12,8" />
                        <TextBlock Text="GLOBAL" Style="{StaticResource ZeroEyebrowStyle}" Margin="12,0,0,8" />
                        <Button Content="About" Click="AboutButton_Click"
                                HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                FontSize="13" Padding="12,8" Cursor="Hand" />
                        <TextBlock x:Name="VersionLabel"
                                   Style="{StaticResource ZeroCaptionStyle}" Margin="12,8,0,0" />
                        <TextBlock Text="Built for a better Roblox experience."
                                   Style="{StaticResource ZeroCaptionStyle}" Margin="12,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top bar: command palette placeholder -->
                <Grid Grid.Row="0" Margin="24,16,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource ZeroCommandPaletteStyle}" HorizontalAlignment="Center" MinWidth="420" MaxWidth="560">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBox Grid.Column="1" x:Name="CommandPaletteBox" BorderThickness="0" Background="Transparent" Margin="8,0,0,0"
                                     FontSize="13" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + K" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource ZeroStatusDotStyle}" Fill="{StaticResource ZeroStatusHealthyBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="Connected" Style="{StaticResource ZeroMetaTextStyle}" FontSize="12" />
                    </StackPanel>
                </Grid>

                <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="0,8,0,0" />
            </Grid>
        </Grid>

        <!-- ============================== STATUS BAR ============================== -->
        <StatusBar Grid.Row="2" Padding="20,10" BorderThickness="0,1,0,0"
                   BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <StatusBar.Background>
                <SolidColorBrush Color="{ui:ThemeResource ApplicationBackgroundColor}" Opacity="0" />
            </StatusBar.Background>
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="StatusHint" Text="Ready." Style="{StaticResource ZeroMetaTextStyle}" FontSize="12" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" Padding="0,0,8,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Save}" Style="{StaticResource ZeroButtonPrimary}" Command="{Binding SaveSettingsCommand, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="2">
                <ui:Button Content="{x:Static resources:Strings.Common_Close}" Style="{StaticResource ZeroButtonGhost}" Command="{Binding CloseWindowCommand, Mode=OneWay}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</base:WpfUiWindow>
