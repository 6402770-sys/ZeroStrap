<Page x:Class="ZeroStrap.UI.Elements.Shell.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="620" d:DesignWidth="860"
      Background="{DynamicResource ApplicationBackgroundBrush}"
      Title="Appearance">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <TextBlock Text="APPEARANCE" Style="{StaticResource ZeroEyebrowStyle}" />
            <TextBlock Text="Theme and interface" Style="{StaticResource ZeroPageTitleStyle}" FontSize="28" />
            <TextBlock Text="Pick a theme, tune typography and interface density." Style="{StaticResource ZeroBodyStyle}" Margin="0,4,0,0" />

            <!-- ============================== THEME PICKER ============================== -->
            <TextBlock Text="THEME" Style="{StaticResource ZeroEyebrowStyle}" Margin="0,28,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ThemeCardDefault" Grid.Column="0" Style="{StaticResource ZeroActionTileStyle}" Margin="0,0,6,0"
                        Tag="Default" MouseLeftButtonUp="ThemeCard_Click">
                    <StackPanel>
                        <Border Height="68" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#101010" />
                                    <GradientStop Offset="1" Color="#F2F2F2" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="System default" Style="{StaticResource ZeroSectionTitleStyle}" Margin="0,10,0,2" />
                        <TextBlock Text="Follows Windows theme." Style="{StaticResource ZeroCaptionStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ThemeCardLight" Grid.Column="1" Style="{StaticResource ZeroActionTileStyle}" Margin="6,0"
                        Tag="Light" MouseLeftButtonUp="ThemeCard_Click">
                    <StackPanel>
                        <Border Height="68" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Background="#F2F2F2">
                            <Rectangle Width="24" Height="24" Fill="#101010" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" RadiusX="4" RadiusY="4" />
                        </Border>
                        <TextBlock Text="Light" Style="{StaticResource ZeroSectionTitleStyle}" Margin="0,10,0,2" />
                        <TextBlock Text="Daylight surfaces, high contrast." Style="{StaticResource ZeroCaptionStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ThemeCardDark" Grid.Column="2" Style="{StaticResource ZeroActionTileStyle}" Margin="6,0,0,0"
                        Tag="Dark" MouseLeftButtonUp="ThemeCard_Click">
                    <StackPanel>
                        <Border Height="68" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Background="#101010">
                            <Rectangle Width="24" Height="24" Fill="#F2F2F2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" RadiusX="4" RadiusY="4" />
                        </Border>
                        <TextBlock Text="Obsidian" Style="{StaticResource ZeroSectionTitleStyle}" Margin="0,10,0,2" />
                        <TextBlock Text="Graphite surfaces, neutral accents." Style="{StaticResource ZeroCaptionStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="ActiveThemeHint" Style="{StaticResource ZeroCaptionStyle}" Margin="0,10,0,0" />

            <!-- ============================== CUSTOM THEME ============================== -->
            <TextBlock Text="CUSTOM BOOTSTRAPPER THEME" Style="{StaticResource ZeroEyebrowStyle}" Margin="0,28,0,8" />
            <Border Style="{StaticResource ZeroCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Selected" Style="{StaticResource ZeroBodyStyle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="CustomThemeText" Text="None" Style="{StaticResource ZeroCaptionStyle}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Manage custom themes" Icon="PaintBrush24"
                                   Style="{StaticResource ZeroButtonGhost}" Click="OpenAdvanced_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================== EMBEDDED ADVANCED ============================== -->
            <Expander Header="Advanced appearance options" IsExpanded="False" Margin="0,24,0,0" Padding="0,8,0,0">
                <Border Style="{StaticResource ZeroCardStyle}" Padding="0" Margin="0,10,0,0">
                    <Frame x:Name="AppearanceHost" NavigationUIVisibility="Hidden" Loaded="AppearanceHost_Loaded" MinHeight="420" />
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
