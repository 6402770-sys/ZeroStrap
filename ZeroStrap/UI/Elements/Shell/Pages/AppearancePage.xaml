<Page x:Class="ZeroStrap.UI.Elements.Shell.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:ZeroStrap.UI.Elements.Shell.Pages"
      xmlns:motion="clr-namespace:ZeroStrap.UI.Utility"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="1030"
      Title="Appearance">

    <Grid Margin="{DynamicResource ZeroPageMarginTabbed}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== HEADER ============================== -->
        <StackPanel Grid.Row="0" motion:Motion.Enter="0">
            <TextBlock Text="A P P E A R A N C E" Style="{StaticResource ZeroEyebrowStyle}" Margin="0,4,0,8" />
            <TextBlock Text="Make it yours" FontSize="{DynamicResource ZeroFontSize30}" FontWeight="{DynamicResource ZeroFontWeightHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Interface themes, motion, and the window Roblox launches with." FontSize="{DynamicResource ZeroFontSize14}" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- ============================== TABS ============================== -->
        <TabControl x:Name="AppearanceTabs" Grid.Row="1" Style="{StaticResource ZeroSegmentedTabControlStyle}" Margin="0,22,0,0"
                    motion:Motion.Enter="1">
            <TabItem x:Name="TabThemes" Header="Themes">
                <local:ThemeStudioView x:Name="Studio" />
            </TabItem>

            <TabItem x:Name="TabLauncher" Header="Launcher window">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="The window shown while Roblox starts: language, style, icon and title."
                               Style="{StaticResource ZeroCaptionStyle}" Margin="2,0,0,12" />
                    <Frame x:Name="AppearanceHost" Grid.Row="1" NavigationUIVisibility="Hidden" Loaded="AppearanceHost_Loaded" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
