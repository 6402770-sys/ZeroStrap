<Page x:Class="ZeroStrap.UI.Elements.Shell.Pages.ConfigurePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:motion="clr-namespace:ZeroStrap.UI.Utility"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="1030"
      Title="Configure">

    <Page.Resources>
        <Style x:Key="StatValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StatLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Normal Configure content. Swapped out (not removed) while a workspace is open, so tab state survives. -->
        <Grid x:Name="MainContent" Margin="40,30,40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================== HEADER ============================== -->
        <StackPanel Grid.Row="0" motion:Motion.Enter="0">
            <TextBlock Text="C O N F I G U R E" Style="{StaticResource ZeroEyebrowStyle}" Margin="0,4,0,8" />
            <TextBlock Text="Shape how Roblox runs" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Fast Flags, mods, integrations, shortcuts and launcher behaviour. Changes apply when you save (Ctrl + S)."
                       FontSize="14" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ============================== STATS STRIP ============================== -->
        <Border Grid.Row="1" Style="{StaticResource ZeroCardStyle}" Padding="0,16" Margin="0,22,0,0" motion:Motion.Enter="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="22,0">
                    <Border Style="{StaticResource ZeroIconTileStyle}"><ui:SymbolIcon Symbol="Flag24" Style="{StaticResource ZeroIconTileGlyphStyle}" /></Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatFlagsCount" Text="0" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Flags configured" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="22,0">
                    <Border Style="{StaticResource ZeroIconTileStyle}"><ui:SymbolIcon Symbol="Sparkle24" Style="{StaticResource ZeroIconTileGlyphStyle}" /></Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatPresetsCount" Text="0" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Presets active" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="3" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="22,0">
                    <Border Style="{StaticResource ZeroIconTileStyle}"><ui:SymbolIcon Symbol="PlugConnected24" Style="{StaticResource ZeroIconTileGlyphStyle}" /></Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatIntegrationsCount" Text="0" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Integrations" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="5" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="22,0">
                    <Border Style="{StaticResource ZeroIconTileStyle}"><ui:SymbolIcon Symbol="PuzzlePiece24" Style="{StaticResource ZeroIconTileGlyphStyle}" /></Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatModsCount" Text="0" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Mod files" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== TABS ============================== -->
        <TabControl x:Name="ConfigureTabs" Grid.Row="2" Style="{StaticResource ZeroSegmentedTabControlStyle}" Margin="0,22,0,0"
                    SelectionChanged="ConfigureTabs_SelectionChanged" motion:Motion.Enter="2">
            <TabItem x:Name="TabFastFlags" Header="Fast Flags">
                <Frame NavigationUIVisibility="Hidden" Loaded="FastFlagsHost_Loaded" />
            </TabItem>
            <TabItem x:Name="TabMods" Header="Mods">
                <Frame NavigationUIVisibility="Hidden" Loaded="ModsHost_Loaded" />
            </TabItem>
            <TabItem x:Name="TabIntegrations" Header="Integrations">
                <Frame NavigationUIVisibility="Hidden" Loaded="IntegrationsHost_Loaded" />
            </TabItem>
            <TabItem x:Name="TabShortcuts" Header="Shortcuts">
                <Frame NavigationUIVisibility="Hidden" Loaded="ShortcutsHost_Loaded" />
            </TabItem>
            <TabItem x:Name="TabBehaviour" Header="Behaviour">
                <Frame NavigationUIVisibility="Hidden" Loaded="BehaviourHost_Loaded" />
            </TabItem>
        </TabControl>
        </Grid>

        <!-- ============================== WORKSPACE ============================== -->
        <!-- Full-section workspace (the Fast Flag Editor). Collapsed until opened; swapped with MainContent by Motion.WorkspaceSwap. -->
        <Frame x:Name="WorkspaceHost" Margin="40,24,40,20" Visibility="Collapsed" IsTabStop="False" NavigationUIVisibility="Hidden"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        PreviewKeyDown="WorkspaceHost_PreviewKeyDown" PreviewMouseDown="WorkspaceHost_PreviewMouseDown" />
    </Grid>
</Page>
