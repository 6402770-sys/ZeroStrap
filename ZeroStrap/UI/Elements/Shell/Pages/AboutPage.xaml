<Page x:Class="ZeroStrap.UI.Elements.Shell.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:motion="clr-namespace:ZeroStrap.UI.Utility"
      xmlns:resources="clr-namespace:ZeroStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="1400" d:DesignWidth="1030"
      Title="About ZeroStrap">

    <Page.Resources>
        <BitmapImage x:Key="CreatorImage" UriSource="pack://application:,,,/Resources/About/creator.jpg" DecodePixelWidth="160" />
        <BitmapImage x:Key="ClaudeImage" UriSource="pack://application:,,,/Resources/About/claude.jpg" DecodePixelWidth="160" />

        <Style x:Key="ZeroLicenseRowStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource ZeroPageMargin}" MaxWidth="1080" HorizontalAlignment="Stretch">

            <!-- ============================== HEADER ============================== -->
            <StackPanel motion:Motion.Enter="0">
                <TextBlock Text="A B O U T" Style="{StaticResource ZeroEyebrowStyle}" Margin="0,4,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource ZeroIconTileStyle}" Width="44" Height="44" CornerRadius="{DynamicResource ZeroRadiusSurface}" Padding="11" Margin="0,0,14,0">
                        <Path Style="{StaticResource ZeroMarkStyle}" />
                    </Border>
                    <TextBlock Text="ZeroStrap" FontSize="{DynamicResource ZeroFontSize30}" FontWeight="{DynamicResource ZeroFontWeightHeading}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Version, Mode=OneTime}" Style="{StaticResource ZeroMetaTextStyle}" Margin="0,8,0,0" HorizontalAlignment="Left" />
                <TextBlock Text="ZeroStrap is an independent Roblox launcher focused on customization, performance tools, and a cleaner desktop experience. Built to give players more control over how they manage and personalize their Roblox client."
                           FontSize="{DynamicResource ZeroFontSize14}" Margin="0,12,0,0" MaxWidth="720" HorizontalAlignment="Left" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- ============================== CREDITS ============================== -->
            <StackPanel motion:Motion.Enter="1">
                <TextBlock Text="Credits" Style="{StaticResource ZeroSectionTitleStyle}" Margin="{DynamicResource ZeroSectionMargin}" />
                <Grid x:Name="CreditsGrid" Margin="0,12,0,0" SizeChanged="CreditsGrid_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="HumanCard" Grid.Column="0" Style="{StaticResource ZeroPanelStyle}" Padding="20" Margin="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="72" Height="72" VerticalAlignment="Center" Margin="0,0,18,0" AutomationProperties.Name="Zero, project creator">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{StaticResource CreatorImage}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Zero" FontSize="{DynamicResource ZeroFontSize17}" FontWeight="{DynamicResource ZeroFontWeightHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Project Creator &amp; Maintainer" Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" Margin="0,2,0,8" />
                                <Border Style="{StaticResource ZeroTagStyle}">
                                    <TextBlock Text="Creator" Style="{StaticResource ZeroTagTextStyle}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="AiCard" Grid.Column="1" Style="{StaticResource ZeroPanelStyle}" Padding="20" Margin="6,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="72" Height="72" RadiusX="16" RadiusY="16" VerticalAlignment="Center" Margin="0,0,18,0" AutomationProperties.Name="Claude, AI assistant">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{StaticResource ClaudeImage}" Stretch="UniformToFill" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Claude" FontSize="{DynamicResource ZeroFontSize17}" FontWeight="{DynamicResource ZeroFontWeightHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Primary AI Development Assistant" Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" Margin="0,2,0,8" />
                                <Border Style="{StaticResource ZeroTagOutlineStyle}">
                                    <TextBlock Text="AI · Anthropic" Style="{StaticResource ZeroTagTextStyle}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ============================== PROJECT ============================== -->
            <StackPanel motion:Motion.Enter="2">
                <TextBlock Text="Project" Style="{StaticResource ZeroSectionTitleStyle}" Margin="{DynamicResource ZeroSectionMargin}" />
                <WrapPanel Margin="0,12,0,0">
                    <ui:Button Content="GitHub repository" Icon="Code24" Style="{StaticResource ZeroButtonSecondary}" Margin="0,0,10,0" Tag="https://github.com/6402770-sys/idkvro" Click="Link_Click" />
                    <ui:Button Content="Report an issue" Icon="Bug24" Style="{StaticResource ZeroButtonSecondary}" Tag="https://github.com/6402770-sys/idkvro/issues" Click="Link_Click" />
                </WrapPanel>
                <TextBlock Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" Margin="0,14,0,0">Based on <Hyperlink NavigateUri="https://github.com/bloxstraplabs/bloxstrap" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource TextFillColorSecondaryBrush}">Bloxstrap</Hyperlink> by pizzaboxer and contributors, used under the MIT License.</TextBlock>
            </StackPanel>

            <!-- ============================== BUILD INFORMATION ============================== -->
            <StackPanel motion:Motion.Enter="3" Visibility="{Binding BuildInformationVisibility, Mode=OneTime}">
                <TextBlock Text="Build information" Style="{StaticResource ZeroSectionTitleStyle}" Margin="{DynamicResource ZeroSectionMargin}" />
                <Border Style="{StaticResource ZeroPanelStyle}" Padding="20,14" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Version" Style="{StaticResource ZeroInfoLabelStyle}" Margin="0,5" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VersionNumber, Mode=OneTime}" Style="{StaticResource ZeroInfoValueStyle}" />
                        <TextBlock Grid.Row="1" Text="Build time" Style="{StaticResource ZeroInfoLabelStyle}" Margin="0,5" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BuildTimestamp, Mode=OneTime}" Style="{StaticResource ZeroInfoValueStyle}" />
                        <TextBlock Grid.Row="2" Text="Machine" Style="{StaticResource ZeroInfoLabelStyle}" Margin="0,5" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BuildMetadata.Machine, Mode=OneTime}" Style="{StaticResource ZeroInfoValueStyle}" />
                        <TextBlock Grid.Row="3" Text="Commit" Style="{StaticResource ZeroInfoLabelStyle}" Margin="0,5" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ZeroInfoValueStyle}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}">
                            <Hyperlink NavigateUri="{Binding BuildCommitHashUrl, Mode=OneTime}" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource TextFillColorPrimaryBrush}"><Run Text="{Binding BuildMetadata.CommitHash, Mode=OneTime}" FontFamily="{StaticResource ZeroMonoFont}" /></Hyperlink>
                        </TextBlock>
                        <TextBlock Grid.Row="4" Text="Reference" Style="{StaticResource ZeroInfoLabelStyle}" Margin="0,5" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BuildMetadata.CommitRef, Mode=OneTime}" Style="{StaticResource ZeroInfoValueStyle}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ============================== LICENSES ============================== -->
            <StackPanel motion:Motion.Enter="4">
                <TextBlock Text="Licenses" Style="{StaticResource ZeroSectionTitleStyle}" Margin="{DynamicResource ZeroSectionMargin}" />
                <Border Style="{StaticResource ZeroPanelStyle}" Padding="8" Margin="0,12,0,0">
                    <UniformGrid x:Name="LicenseGrid" Columns="2">
                        <Button Style="{StaticResource ZeroLicenseRowStyle}" Click="Link_Click" Tag="https://github.com/6402770-sys/idkvro/blob/main/LICENSE">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="ZeroStrap" FontSize="{DynamicResource ZeroFontSize13}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" Style="{StaticResource ZeroMetaTextStyle}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ZeroLicenseRowStyle}" Click="Link_Click" Tag="https://github.com/lepoco/wpfui/blob/main/LICENSE">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="WPF-UI" FontSize="{DynamicResource ZeroFontSize13}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" Style="{StaticResource ZeroMetaTextStyle}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ZeroLicenseRowStyle}" Click="Link_Click" Tag="https://github.com/securifybv/ShellLink/blob/master/LICENSE.txt">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="ShellLink" FontSize="{DynamicResource ZeroFontSize13}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" Style="{StaticResource ZeroMetaTextStyle}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ZeroLicenseRowStyle}" Click="Link_Click" Tag="https://github.com/Lachee/discord-rpc-csharp/blob/master/LICENSE">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="DiscordRPC" FontSize="{DynamicResource ZeroFontSize13}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" Style="{StaticResource ZeroMetaTextStyle}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ZeroLicenseRowStyle}" Click="Link_Click" Tag="https://github.com/MaximumADHD/Roblox-Studio-Mod-Manager/blob/main/LICENSE">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Roblox Studio Mod Manager" FontSize="{DynamicResource ZeroFontSize13}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" Style="{StaticResource ZeroMetaTextStyle}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ZeroLicenseRowStyle}" Click="Link_Click" Tag="https://github.com/icsharpcode/SharpZipLib/blob/master/LICENSE.txt">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="SharpZipLib" FontSize="{DynamicResource ZeroFontSize13}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" Style="{StaticResource ZeroMetaTextStyle}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ZeroLicenseRowStyle}" Click="Link_Click" Tag="https://github.com/xoofx/markdig/blob/master/license.txt">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Markdig" FontSize="{DynamicResource ZeroFontSize13}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_About_Licenses_BSD2}" Style="{StaticResource ZeroMetaTextStyle}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ZeroLicenseRowStyle}" Click="Link_Click" Tag="https://github.com/icsharpcode/AvalonEdit/blob/master/LICENSE">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="AvalonEdit" FontSize="{DynamicResource ZeroFontSize13}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_About_Licenses_MIT}" Style="{StaticResource ZeroMetaTextStyle}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ZeroLicenseRowStyle}" Click="Link_Click" Tag="https://github.com/XamlAnimatedGif/XamlAnimatedGif/blob/master/LICENSE.txt">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="XamlAnimatedGif" FontSize="{DynamicResource ZeroFontSize13}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Static resources:Strings.Menu_About_Licenses_Apache}" Style="{StaticResource ZeroMetaTextStyle}" Margin="12,0,0,0" />
                            </Grid>
                        </Button>
                    </UniformGrid>
                </Border>
            </StackPanel>

            <!-- ============================== TRANSLATIONS ============================== -->
            <StackPanel motion:Motion.Enter="5">
                <TextBlock Text="Translations" Style="{StaticResource ZeroSectionTitleStyle}" Margin="{DynamicResource ZeroSectionMargin}" />
                <TextBlock Text="Community translators, by language." Style="{StaticResource ZeroCaptionStyle}" Margin="0,4,0,0" />
