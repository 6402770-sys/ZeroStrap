<Page x:Class="ZeroStrap.UI.Elements.Shell.Pages.MacroStudioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:motion="clr-namespace:ZeroStrap.UI.Utility"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="1030"
      Title="Macro Studio">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,30,40,40" MaxWidth="1080" HorizontalAlignment="Stretch">

            <!-- ============================== HEADER ============================== -->
            <StackPanel motion:Motion.Enter="0">
                <TextBlock Text="M A C R O   S T U D I O" Style="{StaticResource ZeroEyebrowStyle}" Margin="0,4,0,8" />
                <TextBlock Text="Record it once, run it anytime" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Record keyboard and mouse input, or build a sequence by hand, then edit it on a timeline." FontSize="14" Margin="0,6,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- ============================== NOT YET AVAILABLE ============================== -->
            <Border Style="{StaticResource ZeroPanelStyle}" Margin="0,30,0,0" Padding="24,22" motion:Motion.Enter="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Record24" FontSize="22" VerticalAlignment="Top" Margin="0,2,18,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Macro Studio isn't available yet" Style="{StaticResource ZeroCardTitleStyle}" />
                        <TextBlock Text="Recording, the timeline editor and activation shortcuts arrive in a later update of this build."
                                   Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
