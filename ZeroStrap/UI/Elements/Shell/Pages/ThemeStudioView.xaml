<UserControl x:Class="ZeroStrap.UI.Elements.Shell.Pages.ThemeStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ZeroStrap.UI.Elements.Shell.Pages"
             xmlns:controls="clr-namespace:ZeroStrap.UI.Elements.Controls"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="800">
    <UserControl.Resources>

        <!-- Rail list: no inner ScrollViewer (the rail scrolls as a whole and the wheel must reach it). -->
        <Style x:Key="RailItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" Margin="0,1">
                            <Border x:Name="Hover" CornerRadius="{DynamicResource ZeroRadius8}" Background="{DynamicResource ControlFillColorSecondaryBrush}" Opacity="0" />
                            <Border x:Name="Pill" CornerRadius="{DynamicResource ZeroRadius8}" Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Opacity="0" />
                            <ContentPresenter Margin="10,6" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RailItemStyle}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
        </Style>

        <DataTemplate DataType="{x:Type local:ThemeRailItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Ellipse Style="{StaticResource SwatchDotStyle}" Fill="{Binding Background}" />
                    <Ellipse Style="{StaticResource SwatchDotStyle}" Fill="{Binding Surface}" Margin="-5,0,0,0" />
                    <Ellipse Style="{StaticResource SwatchDotStyle}" Fill="{Binding Text}" Margin="-5,0,0,0" />
                    <Ellipse Style="{StaticResource SwatchDotStyle}" Fill="{Binding Accent}" Margin="-5,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource ZeroFontSize13}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding StatusVisibility}">
                        <ui:SymbolIcon Symbol="Checkmark12" FontSize="11" Margin="0,1,5,0" Foreground="{DynamicResource ZeroStatusHealthyBrush}" />
                        <TextBlock Text="{Binding Status}" FontSize="{DynamicResource ZeroFontSize11}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="GroupLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource ZeroEyebrowStyle}">
            <Setter Property="Margin" Value="4,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================== RAIL ============================== -->
        <Border Grid.Column="0" Style="{StaticResource ZeroCardStyle}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,14,10,12">
                    <TextBlock Text="BUILT-IN" Style="{StaticResource GroupLabelStyle}" />
                    <ListBox x:Name="BuiltinList" Style="{StaticResource RailListStyle}" SelectionChanged="BuiltinList_SelectionChanged"
                             AutomationProperties.Name="Built-in themes" />

                    <TextBlock Text="YOUR THEMES" Style="{StaticResource GroupLabelStyle}" Margin="4,16,0,6" />
                    <ListBox x:Name="CustomList" Style="{StaticResource RailListStyle}" SelectionChanged="CustomList_SelectionChanged"
                             AutomationProperties.Name="Your themes" />
                    <TextBlock x:Name="CustomEmptyHint" Text="None yet. Duplicate a built-in theme or create a new one."
                               Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" Margin="6,2,6,0" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="+ New theme" HorizontalAlignment="Stretch" Style="{StaticResource ZeroButtonSecondary}" Click="NewTheme_Click" />
                        <ui:Button Grid.Column="2" Content="Import…" HorizontalAlignment="Stretch" Style="{StaticResource ZeroButtonGhost}" Click="Import_Click" />
                    </Grid>

                    <Border Style="{StaticResource ZeroDividerStyle}" Margin="0,16,0,14" />

                    <Grid Margin="4,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Match Windows" FontSize="{DynamicResource ZeroFontSize13}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Switches between Obsidian and Light with your Windows setting"
                                       Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="MatchWindowsToggle" Grid.Column="1" Style="{StaticResource ZeroToggle}" VerticalAlignment="Center"
                                         Click="MatchWindows_Click" AutomationProperties.Name="Match Windows" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================== DETAIL ============================== -->
        <ScrollViewer x:Name="DetailScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,14,24">

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="NameText" Text="Obsidian" FontSize="{DynamicResource ZeroFontSize22}" FontWeight="{DynamicResource ZeroFontWeightHeading}" MaxWidth="300"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Border x:Name="KindTag" Grid.Column="1" Style="{StaticResource ZeroTagOutlineStyle}" Margin="12,3,0,0">
                        <TextBlock x:Name="KindTagText" Text="Built-in" Style="{StaticResource ZeroTagTextStyle}" />
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="UseButton" Content="Use this theme" ToolTipService.ShowOnDisabled="True" Style="{StaticResource ZeroButtonPrimary}" Click="UseTheme_Click" />
                        <ui:Button x:Name="MoreButton" Icon="MoreHorizontal24" Margin="6,0,0,0" Style="{StaticResource ZeroIconButton}"
                                   BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" ToolTip="More"
                                   AutomationProperties.Name="More actions" Click="MoreButton_Click">
                            <ui:Button.ContextMenu>
                                <ContextMenu x:Name="MoreMenu" Placement="Bottom" MinWidth="176">
                                    <MenuItem x:Name="MenuRename" Header="Rename" Click="Rename_Click" />
                                    <MenuItem x:Name="MenuDuplicate" Header="Duplicate" Click="Duplicate_Click" />
                                    <MenuItem x:Name="MenuExport" Header="Export…" Click="Export_Click" />
                                    <MenuItem x:Name="MenuRestore" Header="Restore defaults" Click="Restore_Click" />
                                    <Separator x:Name="MenuSeparator" />
                                    <MenuItem x:Name="MenuDelete" Header="Delete" Click="Delete_Click" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- One status line under the header. It always occupies its row (hidden, not collapsed) so showing a note or warning never moves the content below. -->
                <TextBlock x:Name="NoteText" Text=" " Margin="0,8,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource ZeroFontSize12}" Visibility="Hidden"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- Preview -->
                <controls:ThemePreview x:Name="Preview" Margin="0,16,0,0" />

                <!-- Built-in: read-only -->
                <Border x:Name="BuiltinPanel" Style="{StaticResource ZeroCardStyle}" Margin="0,16,0,0" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Built-in themes can't be edited." VerticalAlignment="Center" FontSize="{DynamicResource ZeroFontSize13}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" />
                        <ui:Button Grid.Column="1" Content="Duplicate to customize" Style="{StaticResource ZeroButtonSecondary}" Click="Duplicate_Click" />
                    </Grid>
                </Border>

                <!-- Custom: editor -->
                <Border x:Name="EditorPanel" Style="{StaticResource ZeroCardStyle}" Margin="0,16,0,0" Padding="18,16,18,10">
                    <StackPanel>
                        <ListBox x:Name="SectionTabs" Style="{StaticResource ZeroSegmentedList}" SelectedIndex="0"
                                 SelectionChanged="SectionTabs_SelectionChanged" AutomationProperties.Name="Theme sections">
                            <ListBoxItem Content="Colors" />
                            <ListBoxItem Content="Typography" />
                            <ListBoxItem Content="Layout" />
                            <ListBoxItem Content="Components" />
                            <ListBoxItem Content="Background" />
                        </ListBox>

                        <!-- Colors -->
                        <ItemsControl x:Name="ColorsList" Margin="0,6,0,0" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:ThemeColorRow />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource ZeroEyebrowStyle}" Margin="0,14,0,4" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                        </ItemsControl>

                        <!-- Typography -->
                        <StackPanel x:Name="TypographySection" Visibility="Collapsed" Margin="0,6,0,0">
                            <Grid Margin="0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Font family" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Used for all interface text. Falls back to Inter, then Segoe UI."
                                               Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="FamilyBox" Grid.Column="1" Width="230" Style="{StaticResource ZeroDropdown}" DisplayMemberPath="Display"
                                          SelectionChanged="FamilyBox_SelectionChanged" AutomationProperties.Name="Font family" />
                            </Grid>
                            <Border Style="{StaticResource ZeroDividerStyle}" />

                            <Grid Margin="0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Text size" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Scales every size in the interface from 90 % to 115 %."
                                               Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="ScaleSlider" Width="180" Minimum="90" Maximum="115" TickFrequency="5" SmallChange="5" LargeChange="5"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="ScaleSlider_ValueChanged"
                                            AutomationProperties.Name="Text size" />
                                    <TextBlock x:Name="ScaleLabel" Text="100 %" Width="48" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource ZeroDividerStyle}" />

                            <Grid Margin="0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Body weight" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Weight of regular text." Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ListBox x:Name="BodyWeightList" Grid.Column="1" Style="{StaticResource ZeroSegmentedList}" VerticalAlignment="Center"
                                         SelectionChanged="BodyWeight_SelectionChanged" AutomationProperties.Name="Body weight">
                                    <ListBoxItem Content="Regular" Tag="400" />
                                    <ListBoxItem Content="Medium" Tag="500" />
                                </ListBox>
                            </Grid>
                            <Border Style="{StaticResource ZeroDividerStyle}" />

                            <Grid Margin="0,14,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Heading weight" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Weight of page titles, section titles and card titles." Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ListBox x:Name="HeadingWeightList" Grid.Column="1" Style="{StaticResource ZeroSegmentedList}" VerticalAlignment="Center"
                                         SelectionChanged="HeadingWeight_SelectionChanged" AutomationProperties.Name="Heading weight">
                                    <ListBoxItem Content="Medium" Tag="500" />
                                    <ListBoxItem Content="SemiBold" Tag="600" />
                                    <ListBoxItem Content="Bold" Tag="700" />
                                </ListBox>
                            </Grid>
                        </StackPanel>

                        <!-- Layout -->
                        <StackPanel x:Name="LayoutSection" Visibility="Collapsed" Margin="0,6,0,0">
                            <Grid Margin="0,14,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Density" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="DensityHint" Text="Default spacing." Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ListBox x:Name="DensityList" Grid.Column="1" Style="{StaticResource ZeroSegmentedList}" VerticalAlignment="Center"
                                         SelectionChanged="Density_SelectionChanged" AutomationProperties.Name="Density">
                                    <ListBoxItem Content="Compact" Tag="Compact" />
                                    <ListBoxItem Content="Comfortable" Tag="Comfortable" />
                                    <ListBoxItem Content="Spacious" Tag="Spacious" />
                                </ListBox>
                            </Grid>
                        </StackPanel>

                        <!-- Components -->
                        <StackPanel x:Name="ComponentsSection" Visibility="Collapsed" Margin="0,6,0,0">
                            <Grid Margin="0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Corner radius" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Roundness of buttons, cards and fields, from square (0) to very round (16)."
                                               Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="RadiusSlider" Width="180" Minimum="0" Maximum="16" TickFrequency="1" SmallChange="1" LargeChange="2"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="RadiusSlider_ValueChanged"
                                            AutomationProperties.Name="Corner radius" />
                                    <TextBlock x:Name="RadiusLabel" Text="6 px" Width="48" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource ZeroDividerStyle}" />

                            <Grid Margin="0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Buttons" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Solid uses the accent fill. Subtle uses a light accent tint with accent text."
                                               Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ListBox x:Name="ButtonStyleList" Grid.Column="1" Style="{StaticResource ZeroSegmentedList}" VerticalAlignment="Center"
                                         SelectionChanged="ButtonStyle_SelectionChanged" AutomationProperties.Name="Button style">
                                    <ListBoxItem Content="Solid" Tag="Solid" />
                                    <ListBoxItem Content="Subtle" Tag="Subtle" />
                                </ListBox>
                            </Grid>
                            <Border Style="{StaticResource ZeroDividerStyle}" />

                            <Grid Margin="0,14,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Surfaces" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Outlined cards have a thin border. Flat cards rely on their fill alone."
                                               Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ListBox x:Name="SurfaceStyleList" Grid.Column="1" Style="{StaticResource ZeroSegmentedList}" VerticalAlignment="Center"
                                         SelectionChanged="SurfaceStyle_SelectionChanged" AutomationProperties.Name="Surface style">
                                    <ListBoxItem Content="Flat" Tag="Flat" />
                                    <ListBoxItem Content="Outlined" Tag="Outlined" />
                                </ListBox>
                            </Grid>
                        </StackPanel>

                        <!-- Background -->
                        <StackPanel x:Name="BackgroundSection" Visibility="Collapsed" Margin="0,6,0,0">
                            <Grid Margin="0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Background" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="A picture or a looping video behind the app. The sidebar keeps its own surface."
                                               Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <ListBox x:Name="BackgroundTypeList" Grid.Column="1" Style="{StaticResource ZeroSegmentedList}" VerticalAlignment="Center"
                                         SelectionChanged="BackgroundType_SelectionChanged" AutomationProperties.Name="Background type">
                                    <ListBoxItem Content="None" Tag="None" />
                                    <ListBoxItem Content="Image" Tag="Image" />
                                    <ListBoxItem Content="Video" Tag="Video" />
                                </ListBox>
                            </Grid>

                            <TextBlock x:Name="BackgroundMessage" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,10"
                                       FontSize="{DynamicResource ZeroFontSize12}" AutomationProperties.AutomationId="BackgroundMessage" />

                            <StackPanel x:Name="BackgroundDetails">
                                <Border Style="{StaticResource ZeroDividerStyle}" />

                                <Grid Margin="0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="BackgroundFileText" Text="No file chosen" FontSize="{DynamicResource ZeroFontSize14}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock x:Name="BackgroundFileCaption" Text="" Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ui:Button x:Name="ChooseFileButton" Grid.Column="1" Content="Choose file…" Style="{StaticResource ZeroButtonSecondary}"
                                               VerticalAlignment="Center" Click="ChooseFile_Click" AutomationProperties.Name="Choose background file" />
                                </Grid>

                                <Border x:Name="BackgroundThumb" Width="320" Height="180" HorizontalAlignment="Left" Margin="0,0,0,14" ClipToBounds="True"
                                        CornerRadius="{DynamicResource ZeroRadius8}" BorderThickness="1" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" AutomationProperties.Name="Background preview">
                                    <Grid x:Name="BackgroundThumbHost">
                                        <Image x:Name="BackgroundThumbImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource ZeroDividerStyle}" />

                                <Grid Margin="0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Dim" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Darkens (or lightens) the picture with the theme's background colour so text stays readable."
                                                   Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="DimSlider" Width="180" Minimum="0" Maximum="90" TickFrequency="5" SmallChange="5" LargeChange="10"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="DimSlider_ValueChanged"
                                                AutomationProperties.Name="Dim" />
                                        <TextBlock x:Name="DimLabel" Text="50 %" Width="48" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource ZeroDividerStyle}" />

                                <Grid Margin="0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Blur" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Softens the picture. Strong blur is drawn at half resolution to stay light."
                                                   Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="BlurSlider" Width="180" Minimum="0" Maximum="30" TickFrequency="1" SmallChange="1" LargeChange="5"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="BlurSlider_ValueChanged"
                                                AutomationProperties.Name="Blur" />
                                        <TextBlock x:Name="BlurLabel" Text="0 px" Width="48" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="SpeedRow">
                                    <Border Style="{StaticResource ZeroDividerStyle}" />
                                    <Grid Margin="0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Playback speed" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="From a quarter of normal speed to double."
                                                       Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="SpeedSlider" Width="180" Minimum="25" Maximum="200" TickFrequency="25" SmallChange="25" LargeChange="25"
                                                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SpeedSlider_ValueChanged"
                                                    AutomationProperties.Name="Playback speed" />
                                            <TextBlock x:Name="SpeedLabel" Text="1×" Width="48" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <Border Style="{StaticResource ZeroDividerStyle}" />

                                <Grid Margin="0,14,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="BackgroundCaption" Text="Videos play muted and pause while ZeroStrap is minimized. With reduced motion a still frame is shown."
                                               Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <ui:Button x:Name="RemoveBackgroundButton" Grid.Column="1" Content="Remove background" Style="{StaticResource ZeroButtonGhost}"
                                               VerticalAlignment="Center" Click="RemoveBackground_Click" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Motion -->
                <TextBlock Text="Motion · applies to every theme" Style="{StaticResource ZeroCardTitleStyle}" Margin="0,28,0,10" />
                <Border Style="{StaticResource ZeroCardStyle}" Padding="20,4">
                    <StackPanel>
                        <Grid Margin="0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ZeroIconTileStyle}"><ui:SymbolIcon Symbol="Sparkle24" Style="{StaticResource ZeroIconTileGlyphStyle}" /></Border>
                            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Smooth animations" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Page transitions and staggered entrances. Turn off to reduce motion; hover feedback stays."
                                           Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="AnimationsToggle" Grid.Column="2" Style="{StaticResource ZeroToggle}" Click="AnimationsToggle_Click"
                                             AutomationProperties.Name="Smooth animations" />
                        </Grid>
                        <Border Style="{StaticResource ZeroDividerStyle}" />

                        <Grid Margin="0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="58,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Follow Windows animation setting" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Keeps animations off while Windows animation effects are off."
                                           Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="FollowWindowsToggle" Grid.Column="1" Style="{StaticResource ZeroToggle}" Click="FollowWindowsToggle_Click"
                                             AutomationProperties.Name="Follow Windows animation setting" />
                        </Grid>
                        <Border Style="{StaticResource ZeroDividerStyle}" />

                        <Grid Margin="0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="58,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Transition intensity" FontSize="{DynamicResource ZeroFontSize14}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Subtle travels less and finishes sooner. Needs animations on."
                                           Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <ListBox x:Name="IntensityList" Grid.Column="1" Style="{StaticResource ZeroSegmentedList}" VerticalAlignment="Center"
                                     SelectionChanged="Intensity_SelectionChanged" AutomationProperties.Name="Transition intensity">
                                <ListBoxItem Content="Subtle" Tag="Subtle" />
                                <ListBoxItem Content="Standard" Tag="Standard" />
                            </ListBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
