<Page x:Class="ZeroStrap.UI.Elements.Shell.Pages.ModsStudioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:motion="clr-namespace:ZeroStrap.UI.Utility"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="1030"
      Title="Mods Studio">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{DynamicResource ZeroPageMargin}" MaxWidth="1080" HorizontalAlignment="Stretch">

            <!-- ============================== HEADER ============================== -->
            <StackPanel motion:Motion.Enter="0">
                <TextBlock Text="M O D S   S T U D I O" Style="{StaticResource ZeroEyebrowStyle}" Margin="0,4,0,8" />
                <TextBlock Text="Your mods, one package at a time" FontSize="{DynamicResource ZeroFontSize30}" FontWeight="{DynamicResource ZeroFontWeightHeading}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Install, enable and remove Roblox mods individually, with conflicts shown before they happen." FontSize="{DynamicResource ZeroFontSize14}" Margin="0,6,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- ============================== NOT YET AVAILABLE ============================== -->
            <Border Style="{StaticResource ZeroPanelStyle}" Margin="0,30,0,0" Padding="24,22" motion:Motion.Enter="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="22" VerticalAlignment="Top" Margin="0,2,18,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Mods Studio isn't available yet" Style="{StaticResource ZeroCardTitleStyle}" />
                        <TextBlock Text="Until it is, your mods and built-in presets are managed in Configure › Mods. Nothing there changes when Mods Studio arrives; existing mods are carried over."
                                   Style="{StaticResource ZeroCaptionStyle}" TextWrapping="Wrap" Margin="0,4,24,0" />
                    </StackPanel>
                    <ui:Button Grid.Column="2" Content="Open Configure › Mods" Style="{StaticResource ZeroButtonGhost}"
                               VerticalAlignment="Center" Click="OpenLegacyMods_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
