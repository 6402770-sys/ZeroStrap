<Page x:Class="ZeroStrap.UI.Elements.Shell.Pages.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:ZeroStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="520" d:DesignWidth="860"
      Background="{DynamicResource ApplicationBackgroundBrush}"
      Title="Overview">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- ============================== MAIN COLUMN ============================== -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">

                <!-- Greeting -->
                <TextBlock x:Name="GreetingDay" Style="{StaticResource ZeroEyebrowStyle}" Margin="0" />
                <TextBlock x:Name="GreetingText" Text="Good morning." Style="{StaticResource ZeroPageTitleStyle}" FontSize="32" />
                <TextBlock Text="Your Roblox experience, under control." Style="{StaticResource ZeroBodyStyle}" Margin="0,4,0,0" />

                <!-- Hero: Roblox Client status -->
                <Border Style="{StaticResource ZeroHeroStyle}" Margin="0,24,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource ZeroMarkTileStyle}" Grid.Column="0">
                            <Path Style="{StaticResource ZeroMarkStyle}" Width="36" Height="36" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ROBLOX CLIENT" Style="{StaticResource ZeroEyebrowStyle}" Margin="0,0,8,0" />
                                <Border Style="{StaticResource ZeroChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource ZeroStatusDotStyle}" Fill="{StaticResource ZeroStatusHealthyBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="READY" FontSize="10" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="VersionText" Text="Version unknown" Style="{StaticResource ZeroBodyStyle}" Margin="0,6,0,0" FontSize="13" />
                            <TextBlock x:Name="InstallPathText" Style="{StaticResource ZeroCaptionStyle}" Margin="0,2,0,0" />
                        </StackPanel>

                        <ui:Button Grid.Column="2" x:Name="LaunchButton"
                                   Content="Launch Roblox" Icon="Play24"
                                   Style="{StaticResource ZeroButtonPrimary}"
                                   Padding="20,10"
                                   Click="LaunchButton_Click"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Quick info strip -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ZeroCardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource ZeroEyebrowStyle}" />
                            <TextBlock x:Name="ActiveProfileText" Text="Default" Style="{StaticResource ZeroBodyStyle}" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ZeroCardStyle}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="LAUNCH OPTIONS" Style="{StaticResource ZeroEyebrowStyle}" />
                            <TextBlock x:Name="LaunchOptionsText" Text="No custom options" Style="{StaticResource ZeroBodyStyle}" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ZeroCardStyle}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="INSTALLATION" Style="{StaticResource ZeroEyebrowStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="InstallationStatusText" Text="Up to date" Style="{StaticResource ZeroBodyStyle}" FontWeight="SemiBold" FontSize="14" />
                                <Ellipse Style="{StaticResource ZeroStatusDotStyle}" Fill="{StaticResource ZeroStatusHealthyBrush}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Four action tiles -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ZeroActionTileStyle}" Margin="0,0,6,0" Tag="Configure" MouseLeftButtonUp="Tile_Click">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Settings24" FontSize="24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="Configure" Style="{StaticResource ZeroSectionTitleStyle}" Margin="0,10,0,2" />
                            <TextBlock Text="Fast Flags, settings and more." Style="{StaticResource ZeroCaptionStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ZeroActionTileStyle}" Margin="6,0" Tag="Appearance" MouseLeftButtonUp="Tile_Click">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="PaintBrush24" FontSize="24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="Appearance" Style="{StaticResource ZeroSectionTitleStyle}" Margin="0,10,0,2" />
                            <TextBlock Text="Themes, fonts and UI customization." Style="{StaticResource ZeroCaptionStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ZeroActionTileStyle}" Margin="6,0" Tag="System" MouseLeftButtonUp="Tile_Click">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="DeviceEq24" FontSize="24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="System" Style="{StaticResource ZeroSectionTitleStyle}" Margin="0,10,0,2" />
                            <TextBlock Text="Diagnostics, logs and maintenance." Style="{StaticResource ZeroCaptionStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource ZeroActionTileStyle}" Margin="6,0,0,0" Tag="Play" MouseLeftButtonUp="Tile_Click">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Document24" FontSize="24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="Manage Profiles" Style="{StaticResource ZeroSectionTitleStyle}" Margin="0,10,0,2" />
                            <TextBlock Text="Create, export and restore configurations." Style="{StaticResource ZeroCaptionStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Recent activity -->
                <Border Style="{StaticResource ZeroCardStyle}" Margin="0,24,0,0" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Recent Activity" Style="{StaticResource ZeroSectionTitleStyle}" />
                        <StackPanel x:Name="RecentActivityList" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================== RIGHT SIDEBAR ============================== -->
            <StackPanel Grid.Column="1">
                <!-- System Status -->
                <Border Style="{StaticResource ZeroCardStyle}">
                    <StackPanel>
                        <TextBlock Text="System Status" Style="{StaticResource ZeroSectionTitleStyle}" FontSize="15" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,14">
                            <Ellipse Style="{StaticResource ZeroStatusDotStyle}" Fill="{StaticResource ZeroStatusHealthyBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="All systems operational" Style="{StaticResource ZeroBodyStyle}" FontSize="13" Foreground="{StaticResource ZeroStatusHealthyBrush}" />
                        </StackPanel>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Roblox Client" Style="{StaticResource ZeroBodyStyle}" FontSize="12" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Ready" Style="{StaticResource ZeroMetaTextStyle}" Margin="0,0,6,0" />
                                <Ellipse Style="{StaticResource ZeroStatusDotStyle}" Fill="{StaticResource ZeroStatusHealthyBrush}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Configuration" Style="{StaticResource ZeroBodyStyle}" FontSize="12" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Loaded" Style="{StaticResource ZeroMetaTextStyle}" Margin="0,0,6,0" />
                                <Ellipse Style="{StaticResource ZeroStatusDotStyle}" Fill="{StaticResource ZeroStatusHealthyBrush}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Network" Style="{StaticResource ZeroBodyStyle}" FontSize="12" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Stable" Style="{StaticResource ZeroMetaTextStyle}" Margin="0,0,6,0" />
                                <Ellipse Style="{StaticResource ZeroStatusDotStyle}" Fill="{StaticResource ZeroStatusHealthyBrush}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Disk Space" Style="{StaticResource ZeroBodyStyle}" FontSize="12" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Healthy" Style="{StaticResource ZeroMetaTextStyle}" Margin="0,0,6,0" />
                                <Ellipse Style="{StaticResource ZeroStatusDotStyle}" Fill="{StaticResource ZeroStatusHealthyBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quick Information -->
                <Border Style="{StaticResource ZeroCardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Quick Information" Style="{StaticResource ZeroSectionTitleStyle}" FontSize="15" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Roblox Version" Style="{StaticResource ZeroBodyStyle}" FontSize="12" />
                            <TextBlock x:Name="InfoRobloxVersion" Grid.Column="1" Text="unknown" Style="{StaticResource ZeroMonoTextStyle}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Launcher Version" Style="{StaticResource ZeroBodyStyle}" FontSize="12" />
                            <TextBlock x:Name="InfoLauncherVersion" Grid.Column="1" Text="unknown" Style="{StaticResource ZeroMonoTextStyle}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Platform" Style="{StaticResource ZeroBodyStyle}" FontSize="12" />
                            <TextBlock x:Name="InfoPlatform" Grid.Column="1" Text="Windows" Style="{StaticResource ZeroMonoTextStyle}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Installation Path" Style="{StaticResource ZeroBodyStyle}" FontSize="12" />
                            <TextBlock x:Name="InfoInstallPath" Grid.Column="1" Text="..." Style="{StaticResource ZeroMonoTextStyle}" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Brand pullquote -->
                <Border Style="{StaticResource ZeroCardStyle}" Margin="0,12,0,0" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Better tools." Style="{StaticResource ZeroBodyStyle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Smoother experience." Style="{StaticResource ZeroBodyStyle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="ZeroStrap." Style="{StaticResource ZeroBodyStyle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <Path Grid.Column="1" Style="{StaticResource ZeroMarkStyle}" Width="24" Height="24" Opacity="0.4" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
