<base:WpfUiWindow x:Class="ZeroStrap.UI.Elements.Dialogs.PresetApplyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:ZeroStrap.UI.Elements.Base"
        xmlns:resources="clr-namespace:ZeroStrap.Resources"
        mc:Ignorable="d"
        Title="{x:Static resources:Strings.Dialog_PresetApply_Title}"
        Width="620"
        Height="560"
        MinHeight="400"
        MinWidth="520"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterOwner">
    <Grid Style="{StaticResource ZeroWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" Title="" Icon="{x:Null}" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None">
            <ui:TitleBar.Header>
                <ContentPresenter Content="{x:Static resources:Strings.Dialog_PresetApply_Title}" ContentTemplate="{StaticResource ZeroTitleBarCaption}" VerticalAlignment="Center" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="20,8,20,12">
            <TextBlock x:Name="HeaderText" Style="{StaticResource ZeroSectionTitleStyle}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource ZeroCaptionStyle}"
                       Text="{x:Static resources:Strings.Dialog_PresetApply_Description}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="20,0,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  Conflicts: one picker per flag defined differently by two presets  -->
                <StackPanel x:Name="ConflictsSection">
                    <TextBlock Style="{StaticResource ZeroEyebrowStyle}" Text="{x:Static resources:Strings.Dialog_PresetApply_Conflicts}" />
                    <ItemsControl x:Name="ConflictsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ZeroPanelStyle}" Padding="12,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Flag}" FontFamily="{StaticResource ZeroMonoFont}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Flag}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="Label" SelectionChanged="Conflict_SelectionChanged" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Style="{StaticResource ZeroEyebrowStyle}" Text="{x:Static resources:Strings.Dialog_PresetApply_Changes}" Margin="0,12,0,6" />
                <TextBlock x:Name="ChangesEmptyText" Style="{StaticResource ZeroCaptionStyle}" Visibility="Collapsed" />
                <ItemsControl x:Name="ChangesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource ZeroTagOutlineStyle}">
                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource ZeroTagTextStyle}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Flag}" FontFamily="{StaticResource ZeroMonoFont}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Flag}" />
                                <TextBlock Grid.Column="2" Text="{Binding Summary}" FontFamily="{StaticResource ZeroMonoFont}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="ErrorsText" Margin="0,12,0,0" Style="{StaticResource ZeroCaptionStyle}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource ZeroDialogFooterStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="ApplyButton" MinWidth="100" Appearance="Primary" Content="{x:Static resources:Strings.Dialog_PresetApply_Apply}" Click="ApplyButton_Click" />
                <Button MinWidth="100" Margin="8,0,0,0" Content="{x:Static resources:Strings.Common_Cancel}" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
