<base:WpfUiWindow x:Class="ZeroStrap.UI.Elements.Dialogs.ConnectivityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:ZeroStrap.UI.Elements.Base"
        xmlns:local="clr-namespace:ZeroStrap.UI.Elements.Dialogs"
        xmlns:controls="clr-namespace:ZeroStrap.UI.Elements.Controls"
        xmlns:resources="clr-namespace:ZeroStrap.Resources"
        mc:Ignorable="d"
        Width="500"
        MinHeight="0"
        SizeToContent="Height"
        Title="{x:Static resources:Strings.Dialog_Connectivity_Title}"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowStartupLocation="CenterScreen">
    <Grid Style="{StaticResource ZeroWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="2" Padding="8" x:Name="RootTitleBar" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" Title="" Icon="{x:Null}">
            <ui:TitleBar.Header>
                <ContentPresenter Content="{x:Static resources:Strings.Dialog_Connectivity_Title}" ContentTemplate="{StaticResource ZeroTitleBarCaption}" VerticalAlignment="Center" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="20,16,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="IconImage" Grid.Column="0" Width="32" Height="32" Margin="0,0,16,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/MessageBox/Error.png" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleTextBlock" Text="? is unable to connect to ?" Style="{StaticResource ZeroSectionTitleStyle}" />
                <controls:MarkdownTextBlock x:Name="DescriptionTextBlock" MarkdownText="?" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Static resources:Strings.Dialog_Connectivity_MoreInfo}" Margin="0,16,0,0" Style="{StaticResource ZeroCaptionStyle}" />
                <RichTextBox x:Name="ErrorRichTextBox" Padding="10" Margin="0,8,0,0" Block.LineHeight="2" FontSize="12" FontFamily="{StaticResource ZeroMonoFont}" IsReadOnly="True" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ZeroDialogFooterStyle}">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" MinWidth="100" Content="{x:Static resources:Strings.Common_Close}" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
