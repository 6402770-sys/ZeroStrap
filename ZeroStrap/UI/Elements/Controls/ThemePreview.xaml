<UserControl x:Class="ZeroStrap.UI.Elements.Controls.ThemePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False"
             AutomationProperties.Name="Theme preview">
    <!--
        A miniature app window painted only with local brushes (set from the theme being edited in code-behind),
        so it is independent of the application theme and updates instantly while editing.
    -->
    <Border x:Name="Root" Height="190" CornerRadius="12" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="Sidebar" BorderThickness="0,0,1,0" Padding="10,14" CornerRadius="11,0,0,11">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,14">
                        <Border x:Name="Mark" Width="14" Height="14" CornerRadius="4" />
                        <TextBlock x:Name="BrandText" Text="ZeroStrap" FontSize="11" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border x:Name="NavSelected" CornerRadius="6" Padding="8,5" Margin="0,0,0,3">
                        <TextBlock x:Name="NavSelectedText" Text="Overview" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Border Padding="8,5" Margin="0,0,0,3">
                        <TextBlock x:Name="Nav2Text" Text="Configure" FontSize="11" />
                    </Border>
                    <Border Padding="8,5">
                        <TextBlock x:Name="Nav3Text" Text="Appearance" FontSize="11" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Content -->
            <Border Grid.Column="1" Padding="14">
                <Border x:Name="Card" CornerRadius="10" BorderThickness="1" Padding="14,12" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock x:Name="CardTitle" Text="Launch settings" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="CardCaption" Text="Choose how ZeroStrap looks and behaves." FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="CardMuted" Text="Last changed just now" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="PrimaryButton" CornerRadius="6" Padding="14,6">
                                <TextBlock x:Name="PrimaryText" Text="Primary" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <Border x:Name="SecondaryButton" Grid.Column="1" CornerRadius="6" BorderThickness="1" Padding="14,5" Margin="8,0,0,0">
                                <TextBlock x:Name="SecondaryText" Text="Secondary" FontSize="12" />
                            </Border>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DotSuccess" Width="10" Height="10" Margin="0,0,6,0" />
                                <Ellipse x:Name="DotWarning" Width="10" Height="10" Margin="0,0,6,0" />
                                <Ellipse x:Name="DotDanger" Width="10" Height="10" Margin="0,0,6,0" />
                                <Ellipse x:Name="DotInfo" Width="10" Height="10" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>
