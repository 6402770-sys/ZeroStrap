<UserControl x:Class="ZeroStrap.UI.Elements.Controls.ThemeColorRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ZeroStrap.UI.Elements.Controls"
             xmlns:theming="clr-namespace:ZeroStrap.UI.Theming">
    <UserControl.Resources>
        <!-- Swatch button: rounded colour chip -->
        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="7" BorderThickness="1" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static theming:ContrastLevel.Low}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Foreground" Value="{DynamicResource ZeroStatusWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static theming:ContrastLevel.TooLow}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Foreground" Value="{DynamicResource ZeroStatusErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid MinHeight="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="152" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="108" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <Button x:Name="SwatchButton" Grid.Column="1" Style="{StaticResource SwatchButtonStyle}" Background="{Binding Swatch}"
                Click="SwatchButton_Click" AutomationProperties.Name="{Binding Label, StringFormat={}{0} colour picker}" />

        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Opened="PickerPopup_Opened" Closed="PickerPopup_Closed">
            <Border Margin="10,4,10,14" Padding="12" CornerRadius="12" BorderThickness="1"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#FF000000" />
                </Border.Effect>
                <local:ZeroColorPicker x:Name="Picker" />
            </Border>
        </Popup>

        <ui:TextBox x:Name="HexBox" ClearButtonEnabled="False" Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource ZeroTextField}" VerticalAlignment="Center"
                    FontFamily="{StaticResource ZeroMonoFont}" MaxLength="9"
                    AutomationProperties.Name="{Binding Label, StringFormat={}{0} hex}"
                    GotKeyboardFocus="HexBox_GotKeyboardFocus" LostKeyboardFocus="HexBox_LostKeyboardFocus" PreviewKeyDown="HexBox_PreviewKeyDown" />

        <TextBlock Grid.Column="3" Margin="12,0,0,0" Text="{Binding Note}" Style="{StaticResource NoteStyle}" />
    </Grid>
</UserControl>
