<Window x:Class="ZeroStrap.UI.Elements.Overlay.MacroOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" IsHitTestVisible="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        Title="ZeroStrap macro overlay">
    <!-- Static colors on purpose: the overlay floats over a game, so it does not follow the app theme (and needs no app resources). -->
    <Border CornerRadius="8" Padding="8,6" MaxWidth="260" Background="#CC101012" BorderBrush="#33FFFFFF" BorderThickness="1">
        <ItemsControl x:Name="Rows" Focusable="False" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,1,8,0" StrokeThickness="1" Stroke="{Binding DotStroke}" Fill="{Binding DotFill}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" MaxWidth="150" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontSize="12" Foreground="{Binding NameBrush}" />
                        <Border Grid.Column="2" Margin="10,0,0,0" Padding="5,1,5,2" CornerRadius="4" Background="#26FFFFFF" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Hotkey}" FontSize="10" Foreground="#B3FFFFFF" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
