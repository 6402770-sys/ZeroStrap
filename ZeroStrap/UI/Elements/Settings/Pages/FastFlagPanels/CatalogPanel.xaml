<UserControl x:Class="ZeroStrap.UI.Elements.Settings.Pages.FastFlagPanels.CatalogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="clr-namespace:ZeroStrap.Resources"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="720"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <!--  The catalog tab is a status + preferences panel (it has no list of its own); it scrolls internally when the window is short.  -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,8">
            <TextBlock Style="{StaticResource ZeroCaptionStyle}" Margin="0,0,0,12"
                       Text="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_Notice}" />

            <!--  Current catalog  -->
            <Border Style="{StaticResource ZeroSettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource ZeroEyebrowStyle}" Margin="0,0,0,10" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_Title}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ZeroCaptionStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_Source}" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap">
                        <Hyperlink x:Name="SourceLink" Click="SourceLink_Click"><Run x:Name="SourceText" /></Hyperlink>
                    </TextBlock>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ZeroCaptionStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Tab_Flags}" Margin="0,0,0,8" />
                    <TextBlock x:Name="CountText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ZeroCaptionStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_Version}" Margin="0,0,0,8" />
                    <TextBlock x:Name="VersionText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" FontFamily="{StaticResource ZeroMonoFont}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource ZeroCaptionStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_LastUpdated}" Margin="0,0,0,8" />
                    <TextBlock x:Name="UpdatedText" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource ZeroCaptionStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_LastCheck}" />
                    <TextBlock x:Name="CheckedText" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!--  Check now  -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <ui:Button x:Name="CheckButton" Style="{StaticResource ZeroButtonPrimary}" Icon="ArrowSync24" Content="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_Check}" Click="CheckButton_Click" />
                <ui:Button x:Name="CancelButton" Style="{StaticResource ZeroButtonSecondary}" Content="{x:Static resources:Strings.Common_Cancel}" Margin="8,0,0,0" Click="CancelButton_Click" Visibility="Collapsed" />
                <ui:ProgressRing x:Name="Progress" IsIndeterminate="True" Width="16" Height="16" Margin="12,0,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="ResultText" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource ZeroCaptionStyle}" />
            </StackPanel>

            <!--  Update preferences  -->
            <TextBlock Text="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_Updates}" Style="{StaticResource ZeroSectionTitleStyle}" Margin="{StaticResource ZeroSectionMargin}" />
            <Border Style="{StaticResource ZeroSettingCardStyle}" Margin="0,14,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_Auto}" Style="{StaticResource ZeroCardTitleStyle}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource ZeroCaptionStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_AutoDescription}" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="AutoToggle" Grid.Column="1" Style="{StaticResource ZeroToggle}" Margin="16,0,0,0" VerticalAlignment="Center" Click="AutoToggle_Click" />
                </Grid>
            </Border>
            <Border Style="{StaticResource ZeroSettingCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_Interval}" Style="{StaticResource ZeroCardTitleStyle}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource ZeroCaptionStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_IntervalDescription}" />
                    </StackPanel>
                    <ComboBox x:Name="IntervalBox" Grid.Column="1" Style="{StaticResource ZeroDropdown}" Margin="16,0,0,0" Width="160" VerticalAlignment="Center" SelectionChanged="IntervalBox_SelectionChanged">
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_Interval_6Hours}" Tag="6" />
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_Interval_12Hours}" Tag="12" />
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_Interval_Day}" Tag="24" />
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_Interval_3Days}" Tag="72" />
                        <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Catalog_Interval_Week}" Tag="168" />
                    </ComboBox>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
