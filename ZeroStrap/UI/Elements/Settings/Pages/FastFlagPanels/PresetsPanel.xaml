<UserControl x:Class="ZeroStrap.UI.Elements.Settings.Pages.FastFlagPanels.PresetsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="clr-namespace:ZeroStrap.Resources"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="720"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Preset list  -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                <ui:Button Icon="Add24" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Presets_NewTooltip}" Click="NewButton_Click" Margin="0,0,4,4" Padding="8,6" />
                <ui:Button Icon="Camera24" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Presets_CaptureTooltip}" Click="CaptureButton_Click" Margin="0,0,4,4" Padding="8,6" />
                <ui:Button x:Name="DuplicateButton" Icon="Copy24" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Presets_Duplicate}" Click="DuplicateButton_Click" Margin="0,0,4,4" Padding="8,6" />
                <ui:Button x:Name="RenameButton" Icon="Rename24" ToolTip="{x:Static resources:Strings.Common_Rename}" Click="RenameButton_Click" Margin="0,0,4,4" Padding="8,6" />
                <ui:Button x:Name="DeleteButton" Icon="Delete24" ToolTip="{x:Static resources:Strings.Common_Delete}" Click="DeleteButton_Click" Margin="0,0,4,4" Padding="8,6" />
            </WrapPanel>

            <ListBox x:Name="PresetList" Grid.Row="1" SelectionChanged="PresetList_SelectionChanged" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="EnabledCheckBox_Click" VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0"
                                      ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Presets_IncludeTooltip}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource ZeroCaptionStyle}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="ListEmptyText" Grid.Row="1" Style="{StaticResource ZeroEmptyStateStyle}"
                       Text="{x:Static resources:Strings.Menu_FastFlagEditor_Presets_Empty}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button Icon="ArrowImport24" Content="{x:Static resources:Strings.Common_Import}" Click="ImportButton_Click" Margin="0,0,8,0" />
                <ui:Button Icon="ArrowExportLtr24" Content="{x:Static resources:Strings.Common_Export}" Click="ExportButton_Click" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Presets_ExportTooltip}" />
            </StackPanel>
        </Grid>

        <!--  Selected preset contents  -->
        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ZeroPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource ZeroEyebrowStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Presets_Title}" />
                    <TextBlock x:Name="SelectedName" Style="{StaticResource ZeroSectionTitleStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Presets_SelectPreset}" />
                </StackPanel>

                <DataGrid x:Name="FlagsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" BorderThickness="0" IsReadOnly="True" SelectionMode="Extended" CellStyle="{StaticResource ZeroDataGridCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static resources:Strings.Common_Name}" Binding="{Binding Key}" Width="2*" FontFamily="{StaticResource ZeroMonoFont}" />
                        <DataGridTextColumn Header="{x:Static resources:Strings.Common_Value}" Binding="{Binding Value}" Width="*" FontFamily="{StaticResource ZeroMonoFont}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="FlagsEmptyText" Grid.Row="1" Style="{StaticResource ZeroEmptyStateStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Presets_NoFlags}" Visibility="Collapsed" />

                <Grid x:Name="EditorRow" Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="NewFlagName" Grid.Column="0" PlaceholderText="{x:Static resources:Strings.Menu_FastFlagEditor_FlagName}" FontFamily="{StaticResource ZeroMonoFont}" />
                    <ui:TextBox x:Name="NewFlagValue" Grid.Column="1" Margin="6,0,0,0" PlaceholderText="{x:Static resources:Strings.Common_Value}" FontFamily="{StaticResource ZeroMonoFont}" KeyDown="NewFlagValue_KeyDown" />
                    <ui:Button Grid.Column="2" Margin="6,0,0,0" Icon="Add24" Content="{x:Static resources:Strings.Menu_FastFlagEditor_Details_Set}" Click="SetFlagButton_Click" />
                    <ui:Button Grid.Column="3" Margin="6,0,0,0" Icon="Delete24" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Presets_RemoveFlagsTooltip}" Click="RemoveFlagButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <!--  Apply / revert  -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="SelectionSummary" FontSize="13" />
                <TextBlock x:Name="LastApplyText" Style="{StaticResource ZeroCaptionStyle}" />
            </StackPanel>
            <ui:Button x:Name="RevertButton" Grid.Column="1" Icon="ArrowUndo24" Content="{x:Static resources:Strings.Menu_FastFlagEditor_Presets_Revert}" Click="RevertButton_Click" Margin="0,0,8,0" />
            <ui:Button x:Name="ApplyButton" Grid.Column="2" Icon="Checkmark24" Appearance="Primary" Content="{x:Static resources:Strings.Menu_FastFlagEditor_Presets_Apply}" Click="ApplyButton_Click" />
        </Grid>
    </Grid>
</UserControl>
