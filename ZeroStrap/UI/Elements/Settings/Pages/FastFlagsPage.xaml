<ui:UiPage x:Class="ZeroStrap.UI.Elements.Settings.Pages.FastFlagsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:models="clr-namespace:ZeroStrap.UI.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:ZeroStrap.Resources"
      xmlns:flagpresets="clr-namespace:ZeroStrap.Enums.FlagPresets"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      Title="FastFlagsPage"
      Scrollable="True"
      Loaded="Page_Loaded">

    <ui:UiPage.Resources>
        <!--  Segment label: the enum's display name  -->
        <DataTemplate x:Key="EnumSegmentTemplate">
            <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
        </DataTemplate>

        <!--  Reset link shown only while a segmented value differs from its default  -->
        <Style x:Key="ResetButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource ZeroButtonGhostSmall}">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
    </ui:UiPage.Resources>

    <StackPanel Margin="0,0,14,14">

        <!-- ============================== EDITOR ENTRY ============================== -->
        <Button x:Name="OpenEditorButton" Style="{StaticResource ZeroTileButton}" Command="{Binding OpenFastFlagEditorCommand}"
                Padding="20,18" AutomationProperties.Name="{x:Static resources:Strings.Menu_FastFlagEditor_Title}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ZeroIconTileStyle}" Width="44" Height="44" CornerRadius="12">
                    <ui:SymbolIcon Symbol="EditSettings24" Style="{StaticResource ZeroIconTileGlyphStyle}" FontSize="20" />
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static resources:Strings.Menu_FastFlagEditor_Title}" Style="{StaticResource ZeroCardTitleStyle}" FontSize="16" />
                    <TextBlock Text="Search, add and edit every configured flag, and browse Roblox's flag catalog."
                               Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConfiguredCountText" Style="{StaticResource ZeroMetaTextStyle}" />
                    <ui:SymbolIcon Symbol="ChevronRight24" Style="{StaticResource ZeroChevronStyle}" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </Button>

        <!-- ============================== ENGINE SETTINGS ============================== -->
        <TextBlock Text="Engine settings" Style="{StaticResource ZeroSectionTitleStyle}" Margin="{StaticResource ZeroSectionMargin}" />
        <TextBlock Text="Rendering options on Roblox's allowlist." Style="{StaticResource ZeroCaptionStyle}" Margin="0,4,0,14" />

        <!--  Anti-aliasing  -->
        <Border Style="{StaticResource ZeroSettingCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Presets_MSAA_Title}" Style="{StaticResource ZeroCardTitleStyle}" />
                    <TextBlock Text="Smooths jagged edges. Higher sample counts cost more GPU time." Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                </StackPanel>

                <ui:Button Grid.Row="0" Grid.Column="1" Content="Reset" Click="MsaaReset_Click" AutomationProperties.Name="Reset anti-aliasing to automatic">
                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource ResetButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=MsaaList}" Value="{x:Static flagpresets:MSAAMode.Default}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <ListBox x:Name="MsaaList" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0"
                         Style="{StaticResource ZeroSegmentedList}" ItemTemplate="{StaticResource EnumSegmentTemplate}"
                         ItemsSource="{Binding MSAALevels.Keys, Mode=OneTime}"
                         SelectedItem="{Binding SelectedMSAALevel, Mode=TwoWay}"
                         AutomationProperties.Name="{x:Static resources:Strings.Menu_FastFlags_Presets_MSAA_Title}" />
            </Grid>
        </Border>

        <!--  Texture quality  -->
        <Border Style="{StaticResource ZeroSettingCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Presets_TextureQuality_Title}" Style="{StaticResource ZeroCardTitleStyle}" />
                    <TextBlock Text="Overrides the texture detail Roblox picks automatically." Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                </StackPanel>

                <ui:Button Grid.Row="0" Grid.Column="1" Content="Reset" Click="TextureReset_Click" AutomationProperties.Name="Reset texture quality to automatic">
                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource ResetButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedItem, ElementName=TextureList}" Value="{x:Static flagpresets:TextureQuality.Default}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <ListBox x:Name="TextureList" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0"
                         Style="{StaticResource ZeroSegmentedList}" ItemTemplate="{StaticResource EnumSegmentTemplate}"
                         ItemsSource="{Binding TextureQualities.Keys, Mode=OneTime}"
                         SelectedItem="{Binding SelectedTextureQuality, Mode=TwoWay}"
                         AutomationProperties.Name="{x:Static resources:Strings.Menu_FastFlags_Presets_TextureQuality_Title}" />
            </Grid>
        </Border>

        <!--  Display scaling  -->
        <Border Style="{StaticResource ZeroSettingCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Title}" Style="{StaticResource ZeroCardTitleStyle}" />
                    <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Description}" Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource ZeroToggle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                 IsChecked="{Binding FixDisplayScaling, Mode=TwoWay}"
                                 AutomationProperties.Name="{x:Static resources:Strings.Menu_FastFlags_Presets_FixDisplayScaling_Title}" />
            </Grid>
        </Border>

        <TextBlock Text="Direct3D exclusive fullscreen with Alt + Enter is enabled by default." Style="{StaticResource ZeroCaptionStyle}" Margin="2,2,0,0" />

        <!-- Phase 3: Zero FastFlags collections -->

        <!-- ============================== ADVANCED ============================== -->
        <TextBlock Text="Advanced" Style="{StaticResource ZeroSectionTitleStyle}" Margin="{StaticResource ZeroSectionMargin}" />
        <TextBlock Text="How ZeroStrap applies your flags to Roblox." Style="{StaticResource ZeroCaptionStyle}" Margin="0,4,0,14" />

        <Border Style="{StaticResource ZeroSettingCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Title}" Style="{StaticResource ZeroCardTitleStyle}" />
                    <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Description}" Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource ZeroToggle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                 IsChecked="{Binding UseFastFlagManager, Mode=TwoWay}"
                                 AutomationProperties.Name="{x:Static resources:Strings.Menu_FastFlags_ManagerEnabled_Title}" />
            </Grid>
        </Border>

        <Border Style="{StaticResource ZeroSettingCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Memory flag injection" Style="{StaticResource ZeroCardTitleStyle}" />
                    <TextBlock Text="Write enabled FFlags directly into the running Roblox process after launch via direct syscalls. Supplements ClientAppSettings.json for runtime-reset flags."
                               Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource ZeroToggle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                 IsChecked="{Binding UseMemoryFlagInjection, Mode=TwoWay}"
                                 AutomationProperties.Name="Memory flag injection" />
            </Grid>
        </Border>

        <Border Style="{StaticResource ZeroSettingCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Memory flag watchdog" Style="{StaticResource ZeroCardTitleStyle}" />
                    <TextBlock Text="Keep re-asserting flag values every few seconds while Roblox is running. Requires memory flag injection."
                               Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource ZeroToggle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                 IsChecked="{Binding EnableMemoryFlagWatchdog, Mode=TwoWay}"
                                 AutomationProperties.Name="Memory flag watchdog" />
            </Grid>
        </Border>

        <Border Style="{StaticResource ZeroSettingCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static resources:Strings.Menu_FastFlags_Reset_Title}" Style="{StaticResource ZeroCardTitleStyle}" />
                    <TextBlock Text="Clears every configured flag when you save. Turn it off again to restore them." Style="{StaticResource ZeroCaptionStyle}" Margin="0,3,0,0" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource ZeroToggle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                 IsChecked="{Binding ResetConfiguration, Mode=TwoWay}"
                                 AutomationProperties.Name="{x:Static resources:Strings.Menu_FastFlags_Reset_Title}" />
            </Grid>
        </Border>
    </StackPanel>
</ui:UiPage>
