<ui:UiPage x:Class="ZeroStrap.UI.Elements.Settings.Pages.FastFlagEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:workspace="clr-namespace:ZeroStrap.UI.Elements.Settings.Pages.FastFlagPanels"
      xmlns:models="clr-namespace:ZeroStrap.UI.ViewModels"
      xmlns:resources="clr-namespace:ZeroStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="560" d:DesignWidth="900"
      Title="FastFlagEditorPage"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      SizeChanged="Page_SizeChanged">

    <!--  The editor fills the workspace height: nothing here scrolls except the grid and the details panel.  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: back, title, one-line description  -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource ZeroButtonSecondary}" Icon="ArrowLeft24"
                       Content="{x:Static resources:Strings.Menu_FastFlagEditor_Back}" Click="BackButton_Click" VerticalAlignment="Center" Margin="0,0,16,0"
                       ToolTip="Back (Esc)" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Static resources:Strings.Menu_FastFlagEditor_Title}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Every configured flag, plus Roblox's flag catalog." Style="{StaticResource ZeroCaptionStyle}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Style="{StaticResource ZeroSegmentedTabControlStyle}">
            <!--  ================================ FLAGS ================================  -->
            <TabItem Header="{x:Static resources:Strings.Menu_FastFlagEditor_Tab_Flags}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  What a saved flag actually does, as one quiet caption line  -->
                    <TextBlock x:Name="NoticeText" Grid.Row="0" Style="{StaticResource ZeroCaptionStyle}" Margin="0,0,0,12">
                        <Run Text="Roblox Player only reads flags on " />
                        <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://devforum.roblox.com/t/allowlist-for-local-client-configuration-via-fast-flags/3966569"><Run Text="Roblox's allowlist" /></Hyperlink><Run Text=". Other flags are saved but ignored by the Player. Edits apply after you save and relaunch Roblox." />
                    </TextBlock>

                    <!--  Toolbar row 1: search + filters  -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="SearchTextBox" Grid.Column="0" Style="{StaticResource ZeroTextField}" MinWidth="220" Icon="Search32"
                                    PlaceholderText="{x:Static resources:Strings.Menu_FastFlagEditor_Search}" TextChanged="SearchTextBox_TextChanged" />
                        <ComboBox x:Name="ScopeFilter" Grid.Column="1" Style="{StaticResource ZeroDropdown}" Margin="8,0,0,0" MinWidth="128" SelectedIndex="0"
                                  SelectionChanged="Filter_SelectionChanged" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_Scope}">
                            <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_Configured}" />
                            <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Tab_Catalog}" />
                            <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_Everything}" />
                        </ComboBox>
                        <ComboBox x:Name="TypeFilter" Grid.Column="2" Style="{StaticResource ZeroDropdown}" Margin="8,0,0,0" MinWidth="112" SelectedIndex="0"
                                  SelectionChanged="Filter_SelectionChanged" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_Type}">
                            <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_AnyType}" />
                            <ComboBoxItem Content="Bool" />
                            <ComboBoxItem Content="Int" />
                            <ComboBoxItem Content="String" />
                            <ComboBoxItem Content="Log" />
                        </ComboBox>
                    </Grid>

                    <!--  Toolbar row 2: actions on configured flags (left), loading / result count / errors (right)  -->
                    <Grid Grid.Row="2" Margin="0,10,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:Button Style="{StaticResource ZeroButtonPrimary}" Icon="Add24" Content="Add flag" Click="AddButton_Click" Margin="0,0,8,0" />
                            <ui:Button ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_DeleteSelected}" Icon="Delete24" Click="DeleteButton_Click" Margin="0,0,8,0"
                                       BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource ZeroIconButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=DataGrid, Path=SelectedItems.Count}" Value="0">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ToggleButton x:Name="TogglePresetsButton" Style="{StaticResource ZeroToolbarToggle}" Content="{x:Static resources:Strings.Menu_FastFlagEditor_ShowPresetFlags}"
                                          Click="ToggleButton_Click" Margin="0,0,8,0" />
                            <ui:Button Style="{StaticResource ZeroIconButton}" Icon="ArrowExportLtr24" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_ExportJson}" Click="ExportJSONButton_Click" />
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:ProgressRing x:Name="SearchProgress" Grid.Column="0" IsIndeterminate="True" Width="14" Height="14" Margin="0,0,10,0" Visibility="Collapsed" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right"
                                       Style="{StaticResource ZeroCaptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                    </Grid>

                    <!--  Grid + details. Beside each other when the editor is wide, details docked below otherwise (Page_SizeChanged).  -->
                    <Grid x:Name="MainArea" Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="GridSurface" Grid.Row="0" Grid.Column="0" Style="{StaticResource ZeroGridSurfaceStyle}">
                            <Grid>
                                <DataGrid x:Name="DataGrid" Style="{StaticResource ZeroDataGrid}" CellEditEnding="DataGrid_CellEditEnding"
                                          SelectionChanged="DataGrid_SelectionChanged" EnableRowVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="NameColumn" Header="{x:Static resources:Strings.Common_Name}" Binding="{Binding Name}" Width="2*"
                                                            FontFamily="{StaticResource ZeroMonoFont}" FontSize="13" FontWeight="Normal" ElementStyle="{StaticResource ZeroDataGridTextStyle}"
                                                            EditingElementStyle="{StaticResource ZeroDataGridEditTextBox}" />
                                        <DataGridTextColumn x:Name="ValueColumn" Header="{x:Static resources:Strings.Common_Value}" Binding="{Binding Value}" Width="*"
                                                            FontFamily="{StaticResource ZeroMonoFont}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            ElementStyle="{StaticResource ZeroDataGridTextStyle}" EditingElementStyle="{StaticResource ZeroDataGridEditTextBox}" />
                                        <DataGridTextColumn Header="{x:Static resources:Strings.Menu_FastFlagEditor_Column_Type}" Binding="{Binding TypeLabel}" IsReadOnly="True" Width="96"
                                                            ElementStyle="{StaticResource ZeroDataGridMetaTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!--  Empty states, centred over the grid area  -->
                                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24" Visibility="Collapsed">
                                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource ZeroCardTitleStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock x:Name="EmptyBody" Style="{StaticResource ZeroCaptionStyle}" FontSize="13" TextAlignment="Center" Margin="0,6,0,0" />
                                    <ui:Button x:Name="EmptyAddButton" Style="{StaticResource ZeroButtonPrimary}" Icon="Add24" Content="Add flag" Click="AddButton_Click"
                                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Detail panel for the selected flag  -->
                        <Border x:Name="DetailsPanel" Grid.Row="0" Grid.Column="1" Width="280" Margin="12,0,0,0" Style="{StaticResource ZeroPanelStyle}" VerticalAlignment="Top">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <!-- Two blocks: stacked when the panel is a side column, side by side when it is docked below (Page_SizeChanged). -->
                                <Grid x:Name="DetailsLayout">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="DetailsSecondColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel x:Name="DetailsIdentity" Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{StaticResource ZeroEyebrowStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Details_Title}" />
                                        <TextBlock x:Name="DetailName" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Details_NothingSelected}" TextWrapping="Wrap"
                                                   FontFamily="{StaticResource ZeroMonoFont}" FontSize="13" />
                                        <WrapPanel x:Name="DetailTags" Margin="0,8,0,0" />
                                    </StackPanel>

                                    <StackPanel x:Name="DetailsEditor" Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource ZeroEyebrowStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Details_Value}" Margin="0,0,0,6" />
                                    <TextBox x:Name="DetailValue" FontFamily="{StaticResource ZeroMonoFont}" IsEnabled="False" KeyDown="DetailValue_KeyDown" />
                                    <TextBlock x:Name="DetailError" Margin="0,6,0,0" Style="{StaticResource ZeroCaptionStyle}"
                                               Foreground="{DynamicResource ZeroStatusErrorBrush}" Visibility="Collapsed" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <ui:Button x:Name="DetailSetButton" Style="{StaticResource ZeroButtonPrimary}" Content="{x:Static resources:Strings.Menu_FastFlagEditor_Details_Set}"
                                                   MinWidth="72" IsEnabled="False" Click="DetailSetButton_Click" />
                                        <ui:Button x:Name="DetailRemoveButton" Style="{StaticResource ZeroButtonSecondary}" Content="{x:Static resources:Strings.Menu_FastFlagEditor_Details_Remove}"
                                                   Margin="8,0,0,0" MinWidth="72" IsEnabled="False" Click="DetailRemoveButton_Click" />
                                    </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!--  ================================ PRESETS ================================  -->
            <TabItem Header="{x:Static resources:Strings.Common_Presets}">
                <workspace:PresetsPanel x:Name="PresetsPanel" />
            </TabItem>

            <!--  ================================ CATALOG ================================  -->
            <TabItem Header="{x:Static resources:Strings.Menu_FastFlagEditor_Tab_Catalog}">
                <workspace:CatalogPanel x:Name="CatalogPanel" />
            </TabItem>
        </TabControl>
    </Grid>
</ui:UiPage>
