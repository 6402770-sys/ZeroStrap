<ui:UiPage x:Class="ZeroStrap.UI.Elements.Settings.Pages.FastFlagEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:ZeroStrap.UI.Elements.Settings.Pages"
      xmlns:workspace="clr-namespace:ZeroStrap.UI.Elements.Settings.Pages.FastFlagPanels"
      xmlns:controls="clr-namespace:ZeroStrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:ZeroStrap.UI.ViewModels"
      xmlns:resources="clr-namespace:ZeroStrap.Resources"
      mc:Ignorable="d"
      d:DesignHeight="560" d:DesignWidth="760"
      Title="FastFlagEditorPage"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

    <ui:UiPage.Resources>
        <!--  Row tag: solid for flags Roblox Player reads, outline for experimental ones  -->
        <DataTemplate x:Key="EffectTagTemplate">
            <Border x:Name="Tag" Style="{StaticResource ZeroTagStyle}" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Status_PlayerTooltip}">
                <TextBlock x:Name="TagText" Text="{Binding EffectLabel}" Style="{StaticResource ZeroTagTextStyle}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExperimental}" Value="True">
                    <Setter TargetName="Tag" Property="Style" Value="{StaticResource ZeroTagOutlineStyle}" />
                    <Setter TargetName="Tag" Property="ToolTip" Value="{x:Static resources:Strings.Menu_FastFlagEditor_Status_ExperimentalTooltip}" />
                    <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ui:UiPage.Resources>

    <Grid Margin="0,0,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: back, what this is, experimental mode  -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Icon="ArrowLeft48" Content="{x:Static resources:Strings.Menu_FastFlagEditor_Back}" Click="BackButton_Click" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Description}" Style="{StaticResource ZeroBodyStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </Grid>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Style="{StaticResource ZeroTabControlStyle}">
            <!--  ================================ FLAGS ================================  -->
            <TabItem Header="{x:Static resources:Strings.Menu_FastFlagEditor_Tab_Flags}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  What a saved flag actually does (replaces the old allowlist line + caution banner)  -->
                    <Border Grid.Row="0" Style="{StaticResource ZeroNoticeStyle}" Margin="0,0,0,10" Padding="12,6">
                        <TextBlock x:Name="NoticeText" Style="{StaticResource ZeroCaptionStyle}">
                            <Run Text="{x:Static resources:Strings.Menu_FastFlagEditor_Notice_Start}" />
                            <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://devforum.roblox.com/t/allowlist-for-local-client-configuration-via-fast-flags/3966569"><Run Text="{x:Static resources:Strings.Menu_FastFlagEditor_Notice_Link}" /></Hyperlink><Run Text="{x:Static resources:Strings.Menu_FastFlagEditor_Notice_End}" />
                        </TextBlock>
                    </Border>

                    <!--  Search + filters  -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="SearchTextBox" Grid.Column="0" Icon="Search32" PlaceholderText="{x:Static resources:Strings.Menu_FastFlagEditor_Search}" TextChanged="SearchTextBox_TextChanged" />
                        <ComboBox x:Name="ScopeFilter" Grid.Column="1" Margin="8,0,0,0" MinWidth="128" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_Scope}">
                            <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_Configured}" />
                            <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Tab_Catalog}" />
                            <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_Everything}" />
                        </ComboBox>
                        <ComboBox x:Name="TypeFilter" Grid.Column="2" Margin="8,0,0,0" MinWidth="104" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_Type}">
                            <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_AnyType}" />
                            <ComboBoxItem Content="Bool" />
                            <ComboBoxItem Content="Int" />
                            <ComboBoxItem Content="String" />
                            <ComboBoxItem Content="Log" />
                        </ComboBox>
                        <ComboBox x:Name="EffectFilter" Grid.Column="3" Margin="8,0,0,0" MinWidth="128" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_Status}">
                            <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_AnyStatus}" />
                            <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_Player}" />
                            <ComboBoxItem Content="{x:Static resources:Strings.Menu_FastFlagEditor_Filter_Experimental}" />
                        </ComboBox>
                    </Grid>

                    <!--  Actions on configured flags + result count / catalog state / errors  -->
                    <Grid Grid.Row="2" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:Button Icon="Add28" Appearance="Primary" Content="{x:Static resources:Strings.Menu_FastFlagEditor_AddNew}" Click="AddButton_Click" Margin="0,0,6,0" Padding="10,5" />
                            <ui:Button Icon="Delete48" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_DeleteSelected}" Click="DeleteButton_Click" Appearance="Danger" Margin="0,0,6,0" Padding="10,5">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=DataGrid, Path=SelectedItems.Count}" Value="0">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ToggleButton x:Name="TogglePresetsButton" Content="{x:Static resources:Strings.Menu_FastFlagEditor_ShowPresetFlags}" Click="ToggleButton_Click" Margin="0,0,6,0" Padding="10,5" />
                            <ui:Button Icon="ArrowExportRtl24" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_ExportJson}" Click="ExportJSONButton_Click" Padding="10,5" />
                        </StackPanel>
                        <ui:ProgressRing x:Name="SearchProgress" Grid.Column="1" IsIndeterminate="True" Width="14" Height="14" Margin="14,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource ZeroCaptionStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <DataGrid Name="DataGrid" Grid.Column="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CellEditEnding="DataGrid_CellEditEnding" CanUserReorderColumns="False"
                                  SelectionChanged="DataGrid_SelectionChanged" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Height" Value="30" />
                                    <Setter Property="Padding" Value="8,0,8,0" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{DynamicResource TextOnAccentFillColorPrimary}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{DynamicResource SystemAccentColorSecondary}" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}" Padding="6,0,6,0">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{x:Static resources:Strings.Menu_FastFlagEditor_Column_Status}" IsReadOnly="True" CellTemplate="{StaticResource EffectTagTemplate}" Width="Auto" />
                                <DataGridTextColumn x:Name="NameColumn" Header="{x:Static resources:Strings.Common_Name}" Binding="{Binding Name}" Width="2*" FontFamily="{StaticResource ZeroMonoFont}" />
                                <DataGridTextColumn x:Name="ValueColumn" Header="{x:Static resources:Strings.Common_Value}" Binding="{Binding Value}" Width="*" FontFamily="{StaticResource ZeroMonoFont}" />
                                <DataGridTextColumn Header="{x:Static resources:Strings.Menu_FastFlagEditor_Column_Type}" Binding="{Binding TypeLabel}" IsReadOnly="True" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="EmptyStateText" Grid.Column="0" Style="{StaticResource ZeroEmptyStateStyle}" Visibility="Collapsed" />

                        <!--  Detail panel for the selected flag  -->
                        <Border x:Name="DetailsPanel" Grid.Column="1" Width="240" Margin="12,0,0,0" Style="{StaticResource ZeroPanelStyle}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ZeroEyebrowStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Details_Title}" />
                                <TextBlock x:Name="DetailName" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Details_NothingSelected}" TextWrapping="Wrap" FontFamily="{StaticResource ZeroMonoFont}" FontSize="13" />
                                <WrapPanel x:Name="DetailTags" Margin="0,8,0,0" />
                                <TextBlock x:Name="DetailEffect" Margin="0,8,0,0" Style="{StaticResource ZeroCaptionStyle}" />

                                <TextBlock Style="{StaticResource ZeroEyebrowStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Details_Value}" Margin="0,14,0,6" />
                                <TextBox x:Name="DetailValue" FontFamily="{StaticResource ZeroMonoFont}" IsEnabled="False" KeyDown="DetailValue_KeyDown" />
                                <TextBlock x:Name="DetailError" Margin="0,6,0,0" Style="{StaticResource ZeroCaptionStyle}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ui:Button x:Name="DetailSetButton" Content="{x:Static resources:Strings.Menu_FastFlagEditor_Details_Set}" Appearance="Primary" MinWidth="72" IsEnabled="False" Click="DetailSetButton_Click" />
                                    <ui:Button x:Name="DetailRemoveButton" Content="{x:Static resources:Strings.Menu_FastFlagEditor_Details_Remove}" Margin="8,0,0,0" MinWidth="72" IsEnabled="False" Click="DetailRemoveButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!--  ================================ PRESETS ================================  -->
            <TabItem Header="{x:Static resources:Strings.Common_Presets}">
                <workspace:PresetsPanel x:Name="PresetsPanel" Margin="0,12,0,0" />
            </TabItem>

            <!--  ================================ BINDINGS ================================  -->
            <TabItem Header="{x:Static resources:Strings.Common_Shortcuts}">
                <workspace:BindingsPanel x:Name="BindingsPanel" Margin="0,12,0,0" />
            </TabItem>

            <!--  ================================ CATALOG ================================  -->
            <TabItem Header="{x:Static resources:Strings.Menu_FastFlagEditor_Tab_Catalog}">
                <workspace:CatalogPanel x:Name="CatalogPanel" Margin="0,12,0,0" />
            </TabItem>
        </TabControl>
    </Grid>
</ui:UiPage>
