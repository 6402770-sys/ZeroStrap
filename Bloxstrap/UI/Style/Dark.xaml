<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ===================== ZeroBootstrap BLACKOUT palette =====================
         Deep black #0B0B0B / base #151515 / surfaces #202020 / elevated #282828
         borders #363636 / text #F5F5F5 / secondary #A0A0A0 / accent #D4D4D4  -->
    <Color x:Key="ApplicationBackgroundColor">#FF151515</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}" />

    <!--  Solid layer bases  -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF151515" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF131313" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF282828" />

    <!--  Cards / layers (surfaces)  -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF282828" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF202020" />

    <!--  Strokes / borders / dividers  -->
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF363636" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF363636" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FF363636" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF363636" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF3E3E3E" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#FF363636" />

    <!--  Control fills (ui:Card and inputs read these COLORS, not brushes)  -->
    <Color x:Key="ControlFillColorDefault">#FF202020</Color>
    <Color x:Key="ControlFillColorSecondary">#FF242424</Color>
    <Color x:Key="ControlFillColorTertiary">#FF282828</Color>
    <Color x:Key="ControlFillColorInputActive">#FF131313</Color>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource ControlFillColorSecondary}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource ControlFillColorTertiary}" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource ControlFillColorInputActive}" />

    <!--  Elevation border: default Card border brush  -->
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#FF363636" />

    <!--  Text hierarchy  -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF8C8C8C" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF5E5E5E" />
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="#FF6E6E6E" />

    <SolidColorBrush x:Key="NewTextEditorBackground" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="White" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#E0E0E0" />
</ResourceDictionary>