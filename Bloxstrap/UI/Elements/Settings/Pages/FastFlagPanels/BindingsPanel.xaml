<UserControl x:Class="Bloxstrap.UI.Elements.Settings.Pages.FastFlagPanels.BindingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:resources="clr-namespace:Bloxstrap.Resources"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="720"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ZeroNoticeStyle}" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource ZeroCaptionStyle}"
                       Text="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_Notice}" />
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button x:Name="EditButton" Icon="Edit24" Content="{x:Static resources:Strings.Common_Edit}" Click="EditButton_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="DeleteButton" Icon="Delete24" Content="{x:Static resources:Strings.Common_Delete}" Click="DeleteButton_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_Enabled}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13" />
                <ui:ToggleSwitch x:Name="MasterToggle" Click="MasterToggle_Click" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_EnabledTooltip}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <DataGrid x:Name="BindingsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="Transparent" BorderThickness="0" IsReadOnly="True" SelectionMode="Single" CellStyle="{StaticResource ZeroDataGridCellStyle}" SelectionChanged="BindingsGrid_SelectionChanged" MouseDoubleClick="BindingsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_Column_On}" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="EnabledCheckBox_Click" MinWidth="0" Tag="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_Column_Shortcut}" Binding="{Binding Gesture}" Width="Auto" FontFamily="{StaticResource ZeroMonoFont}" />
                    <DataGridTextColumn Header="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_Column_Flag}" Binding="{Binding FlagName}" Width="2*" FontFamily="{StaticResource ZeroMonoFont}" />
                    <DataGridTextColumn Header="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_Column_Values}" Binding="{Binding ValuesText}" Width="*" FontFamily="{StaticResource ZeroMonoFont}" />
                    <DataGridTextColumn Header="" Binding="{Binding Warning}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Style="{StaticResource ZeroEmptyStateStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_Empty}" />
        </Grid>

        <!--  Editor  -->
        <Border Grid.Row="3" Style="{StaticResource ZeroPanelStyle}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="EditorTitle" Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource ZeroEyebrowStyle}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_NewTitle}" />

                <TextBox x:Name="GestureBox" Grid.Row="1" Grid.Column="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" FontFamily="{StaticResource ZeroMonoFont}"
                         PreviewKeyDown="GestureBox_PreviewKeyDown" ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_GestureTooltip}" Text="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_PressKeys}" />
                <ui:TextBox x:Name="FlagBox" Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" PlaceholderText="{x:Static resources:Strings.Menu_FastFlagEditor_FlagName}" FontFamily="{StaticResource ZeroMonoFont}" />
                <ui:TextBox x:Name="ValuesBox" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" PlaceholderText="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_ValuesPlaceholder}" FontFamily="{StaticResource ZeroMonoFont}"
                            ToolTip="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_ValuesTooltip}" />

                <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <CheckBox x:Name="UnsetBox" Content="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_IncludeUnset}" />
                        <TextBlock x:Name="EditorError" Style="{StaticResource ZeroCaptionStyle}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" Margin="0,4,0,0" />
                    </StackPanel>
                    <ui:Button x:Name="CancelEditButton" Grid.Column="1" Content="{x:Static resources:Strings.Common_Cancel}" Click="CancelEditButton_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                    <ui:Button x:Name="SaveBindingButton" Grid.Column="2" Appearance="Primary" Icon="Add24" Content="{x:Static resources:Strings.Menu_FastFlagEditor_Shortcuts_Add}" Click="SaveBindingButton_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
